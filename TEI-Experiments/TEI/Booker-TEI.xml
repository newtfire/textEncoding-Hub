  <text>
      <body>
         <pb n="1"/>
         <div type="poem" subtype="literary-work">
            <head>The Ballad of Booker T.
            <persName>Booker T.</persName>
            </head>
            <lg type="stanza">
               <l>But <persName>Booker T.</persName> was nobody's fool;</l>
               <l>You may carve a dream with a humble tool.</l>
            </lg>
            <lg type="stanza">
               <l>He said, Till the cup gets dry,</l>
               <l>Work and learn for the land.</l>
            </lg>
         </div>
      </body>
  </text>
