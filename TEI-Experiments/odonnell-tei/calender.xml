                  <msItem>
                     <title>Friendship Calendar Pages</title>
                     <note>
                        2 calendar pages from March 11, March 12 and
                        March 17, 1909.
                     </note>
                  </msItem>
               </msContents>
               
               <physDesc>
                  <p>
                     Printed paper calendar pages with drawings,
                     colored details, and handwritten annotations in
                     ink. The pages have punched holes near the top. 
                  </p>
               </physDesc>
               
               <history>
                  <origin>
                     <p>
                        The calendar was published by Friendship Calendar Co.
                        in New Britain, Connecticut. The pages are copyrighted
                        from 1908. 
                     </p>
                  </origin>
