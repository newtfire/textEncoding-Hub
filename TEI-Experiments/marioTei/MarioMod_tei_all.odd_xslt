<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">The value <inline>true</inline> indicates that the sound is heard between the surrounding speeches; the value <inline>false</inline> indicates that the sound overlaps one or more of the surrounding speeches.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
