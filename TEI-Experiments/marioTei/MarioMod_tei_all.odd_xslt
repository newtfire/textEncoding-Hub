tei_teidata.namespace = xsd:anyURI { pattern = "\S+" }</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The range of syntactically valid values is defined by <basic-link external-destination="url(https://www.ietf.org/rfc/rfc3986.txt)">RFC 3986 <inline font-style="italic">Uniform Resource Identifier (URI): Generic Syntax</inline></basic-link></block></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.teidata.numeric" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">5.11. teidata.numeric</block><table text-align="left" font-size="9pt" id="d27e442992"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
