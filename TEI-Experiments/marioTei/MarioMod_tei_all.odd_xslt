<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;phr&gt;</inline>
 <inline>&lt;w&gt;</inline>do<inline>&lt;/w&gt;</inline>
 <inline>&lt;w&gt;</inline>you<inline>&lt;/w&gt;</inline>
 <inline>&lt;w&gt;</inline>understand<inline>&lt;/w&gt;</inline>
 <inline>&lt;pc type="interrogative"&gt;</inline>?<inline>&lt;/pc&gt;</inline>
<inline>&lt;/phr&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Example encoding of the German sentence <inline font-style="italic" font-weight="normal">Wir fahren in den Urlaub.</inline>, encoded with attributes from <inline color="black" font-family="Helvetica">att.linguistic</inline> discussed in section .<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;s&gt;</inline>
 <inline>&lt;w pos="PPER" msd="1.Pl.*.Nom"&gt;</inline>Wir<inline>&lt;/w&gt;</inline>
 <inline>&lt;w pos="VVFIN" msd="1.Pl.Pres.Ind"&gt;</inline>fahren<inline>&lt;/w&gt;</inline>
 <inline>&lt;w pos="APPR" msd="--"&gt;</inline>in<inline>&lt;/w&gt;</inline>
 <inline>&lt;w pos="ART" msd="Def.Masc.Akk.Sg."&gt;</inline>den<inline>&lt;/w&gt;</inline>
 <inline>&lt;w pos="NN" msd="Masc.Akk.Sg."&gt;</inline>Urlaub<inline>&lt;/w&gt;</inline>
 <inline>&lt;pc pos="$." msd="--" join="left"&gt;</inline>.<inline>&lt;/pc&gt;</inline>
<inline>&lt;/s&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="0"
  maxOccurs="unbounded"&gt;
  &lt;textNode/&gt;
  &lt;classRef key="model.gLike"/&gt;
  &lt;elementRef key="c"/&gt;
  &lt;classRef key="model.pPart.edit"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element pc
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.linguistic.attributes,
   tei_att.segLike.attributes,
   tei_att.typed.attributes,
   attribute force { "strong" | "weak" | "inter" }?,
   attribute unit { text }?,
   attribute pre { text }?,
   ( text | tei_model.gLike | c | tei_model.pPart.edit )*
}</block></block></table-cell></table-row></table-body></table>
