<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Attributes</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="6pt" space-after="6pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal">att.internetMedia</block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="4pt" space-after="4pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>@mimeType</inline></block></list-item-body></list-item></list-block></list-item-body></list-item></list-block><table text-align="left" font-size="9pt" id="d27e434890"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block>width</block></table-cell><table-cell padding="2pt" text-align="left"><block>Where the media are displayed, indicates the display width.<table text-align="left" font-size="9pt" id="d27e434897"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
