<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>This example references a definition of a measurement unit declared in the TEI header: <block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;measure type="weight"&gt;</inline>
 <inline>&lt;num&gt;</inline>2<inline>&lt;/num&gt;</inline> pounds of flesh
<inline>&lt;/measure&gt;</inline>
<inline>&lt;measure type="currency"&gt;</inline>£10-11-6d<inline>&lt;/measure&gt;</inline>
<inline>&lt;measure type="area" unitRef="#merk"&gt;</inline>2 <inline>&lt;unit&gt;</inline>merks<inline>&lt;/unit&gt;</inline> of old extent<inline>&lt;/measure&gt;</inline>
<inline>&lt;!-- In the TEI Header: --&gt;</inline>
<inline>&lt;encodingDesc&gt;</inline>
 <inline>&lt;unitDecl&gt;</inline>
  <inline>&lt;unitDef xml:id="merk" type="area"&gt;</inline>
   <inline>&lt;label&gt;</inline>merk<inline>&lt;/label&gt;</inline>
   <inline>&lt;placeName ref="#Scotland"/&gt;</inline>
   <inline>&lt;desc&gt;</inline>A merk was an area of land determined variably by its agricultural
       productivity.<inline>&lt;/desc&gt;</inline>
  <inline>&lt;/unitDef&gt;</inline>
 <inline>&lt;/unitDecl&gt;</inline>
<inline>&lt;/encodingDesc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;measure quantity="40" unit="hogshead"
 commodity="rum"&gt;</inline>2 score hh rum<inline>&lt;/measure&gt;</inline>
<inline>&lt;measure quantity="12" unit="count"
 commodity="roses"&gt;</inline>1 doz. roses<inline>&lt;/measure&gt;</inline>
<inline>&lt;measure quantity="1" unit="count"
 commodity="tulips"&gt;</inline>a yellow tulip<inline>&lt;/measure&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;head&gt;</inline>Long papers.<inline>&lt;/head&gt;</inline>
<inline>&lt;p&gt;</inline>Speakers will be given 30 minutes each: 20 minutes for
 presentation, 10 minutes for discussion. Proposals should not
 exceed <inline>&lt;measure max="500" unit="count"
  commodity="words"&gt;</inline>500
   words<inline>&lt;/measure&gt;</inline>. This presentation type is suitable for
 substantial research, theoretical or critical discussions.<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.phraseSeq"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element measure
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.measurement.attributes,
   tei_att.ranging.attributes,
   tei_att.typed.attribute.subtype,
   attribute type { text }?,
   tei_macro.phraseSeq
}</block></block></table-cell></table-row></table-body></table>
