<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The <basic-link internal-destination="TEI.writing" text-decoration="underline">&lt;writing&gt;</basic-link> element will usually be short and most simply transcribed as a character string; the content model also allows a sequence of paragraphs and paragraph-level elements, in case the writing has enough internal structure to warrant such markup. In either case the usual phrase-level tags for written text are available.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
<inline>&lt;!-- ... --&gt;</inline><inline>&lt;l&gt;</inline>man in a coonskin cap<inline>&lt;/l&gt;</inline>
<inline>&lt;writing&gt;</inline>coonskin<inline>&lt;/writing&gt;</inline>
<inline>&lt;l&gt;</inline>in a pig pen<inline>&lt;/l&gt;</inline>
<inline>&lt;writing&gt;</inline>pig pen<inline>&lt;/writing&gt;</inline>
<inline>&lt;l&gt;</inline>wants eleven dollar bills<inline>&lt;/l&gt;</inline>
<inline>&lt;writing&gt;</inline>20 dollar bills<inline>&lt;/writing&gt;</inline>
<inline>&lt;l&gt;</inline>you only got ten<inline>&lt;/l&gt;</inline>
<inline>&lt;writing&gt;</inline>10<inline>&lt;/writing&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
