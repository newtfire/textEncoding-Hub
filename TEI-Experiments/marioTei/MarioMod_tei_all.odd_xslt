rline">note</basic-link> <basic-link internal-destination="TEI.noteGrp" text-decoration="underline">noteGrp</basic-link> <basic-link internal-destination="TEI.pb" text-decoration="underline">pb</basic-link></inline></block><block><inline font-weight="bold">drama: </inline><inline><basic-link internal-destination="TEI.castGroup" text-decoration="underline">castGroup</basic-link> <basic-link internal-destination="TEI.castItem" text-decoration="underline">castItem</basic-link> <basic-link internal-destination="TEI.roleDesc" text-decoration="underline">roleDesc</basic-link></inline></block><block><inline font-weight="bold">figures: </inline><inline><basic-link internal-destination="TEI.figure" text-decoration="underline">figure</basic-link> <basic-link internal-destination="TEI.notatedMusic" text-decoration="underline">notatedMusic</basic-link></inline></block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.fLib" text-decoration="underline">fLib</basic-link> <basic-link internal-destination="TEI.fs" text-decoration="underline">fs</basic-link> <basic-link internal-destination="TEI.fvLib" text-decoration="underline">fvLib</basic-link></inline></block><block><inline font-weight="bold">spoken: </inline><inline><basic-link internal-destination="TEI.incident" text-decoration="underline">incident</basic-link> <basic-link internal-destination="TEI.kinesic" text-decoration="underline">kinesic</basic-link> <basic-link internal-destination="TEI.pause" text-decoration="underline">pause</basic-link> <basic-link internal-destination="TEI.shift" text-decoration="underline">shift</basic-link> <basic-link internal-destination="TEI.vocal" text-decoration="underline">vocal</basic-link> <basic-link internal-destination="TEI.writing" text-decoration="underline">writing</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.app" text-decoration="underline">app</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link></inline></block><block><inline font-weight="bold">textstructure: </inline><inline><basic-link internal-destination="TEI.trailer" text-decoration="underline">trailer</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.addSpan" text-decoration="underline">addSpan</basic-link> <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">damageSpan</basic-link> <basic-link internal-destination="TEI.delSpan" text-decoration="underline">delSpan</basic-link> <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link> <basic-link internal-destination="TEI.listTranspose" text-decoration="underline">listTranspose</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.space" text-decoration="underline">space</basic-link> <basic-link internal-destination="TEI.substJoin" text-decoration="underline">substJoin</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The <inline font-style="italic">rend</inline> attribute may be used, as here, to indicate whether the grouping is indicated by a brace, whitespace, font change, etc.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">Note that in this example the role description ‘friends of Mathias’ is understood to apply to both roles equally.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;castGroup rend="braced"&gt;</inline>
 <inline>&lt;castItem&gt;</inline>
  <inline>&lt;role&gt;</inline>Walter<inline>&lt;/role&gt;</inline>
  <inline>&lt;actor&gt;</inline>Mr Frank Hall<inline>&lt;/actor&gt;</inline>
 <inline>&lt;/castItem&gt;</inline>
 <inline>&lt;castItem&gt;</inline>
  <inline>&lt;role&gt;</inline>Hans<inline>&lt;/role&gt;</inline>
  <inline>&lt;actor&gt;</inline>Mr F.W. Irish<inline>&lt;/actor&gt;</inline>
 <inline>&lt;/castItem&gt;</inline>
 <inline>&lt;roleDesc&gt;</inline>friends of Mathias<inline>&lt;/roleDesc&gt;</inline>
<inline>&lt;/castGroup&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.global"/&gt;
   &lt;classRef key="model.headLike"/&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="1"
   maxOccurs="unbounded"&gt;
   &lt;alternate&gt;
    &lt;elementRef key="castItem"/&gt;
    &lt;elementRef key="castGroup"/&gt;
    &lt;elementRef key="roleDesc"/&gt;
   &lt;/alternate&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
  &lt;sequence minOccurs="0"&gt;
   &lt;elementRef key="trailer"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element castGroup
{
   tei_att.global.attributes,
   tei_att.performed.attributes,
   (
      ( tei_model.global | tei_model.headLike )*,
      (
         ( ( tei_castItem | tei_castGroup | tei_roleDesc ), tei_model.global* )+
      ),
      ( ( tei_trailer, tei_model.global* )? )
   )
}</block></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.castItem" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">1.48. &lt;castItem&gt;</block><table text-align="left" font-size="9pt" id="d27e35990"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
