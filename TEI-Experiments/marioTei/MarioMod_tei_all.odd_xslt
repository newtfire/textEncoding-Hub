<table-row><table-cell padding="2pt" text-align="left"><block>value</block></table-cell><table-cell padding="2pt" text-align="left"><block>supplies a value for the triangle, in the form of the identifier of a feature structure or other analytic element.<table text-align="left" font-size="9pt" id="d27e373451"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
