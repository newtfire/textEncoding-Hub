 <inline>&lt;f name="lex"&gt;</inline>
  <inline>&lt;symbol value="auxquels"/&gt;</inline>
 <inline>&lt;/f&gt;</inline>
 <inline>&lt;f name="maf"&gt;</inline>
  <inline>&lt;vColl org="list"&gt;</inline>
   <inline>&lt;fs&gt;</inline>
    <inline>&lt;f name="cat"&gt;</inline>
     <inline>&lt;symbol value="prep"/&gt;</inline>
    <inline>&lt;/f&gt;</inline>
