nderline">conversion</basic-link> <basic-link internal-destination="TEI.country" text-decoration="underline">country</basic-link> <basic-link internal-destination="TEI.creation" text-decoration="underline">creation</basic-link> <basic-link internal-destination="TEI.custEvent" text-decoration="underline">custEvent</basic-link> <basic-link internal-destination="TEI.death" text-decoration="underline">death</basic-link> <basic-link internal-destination="TEI.district" text-decoration="underline">district</basic-link> <basic-link internal-destination="TEI.docDate" text-decoration="underline">docDate</basic-link> <basic-link internal-destination="TEI.editor" text-decoration="underline">editor</basic-link> <basic-link internal-destination="TEI.education" text-decoration="underline">education</basic-link> <basic-link internal-destination="TEI.event" text-decoration="underline">event</basic-link> <basic-link internal-destination="TEI.eventName" text-decoration="underline">eventName</basic-link> <basic-link internal-destination="TEI.faith" text-decoration="underline">faith</basic-link> <basic-link internal-destination="TEI.floruit" text-decoration="underline">floruit</basic-link> <basic-link internal-destination="TEI.funder" text-decoration="underline">funder</basic-link> <basic-link internal-destination="TEI.gender" text-decoration="underline">gender</basic-link> <basic-link internal-destination="TEI.geogFeat" text-decoration="underline">geogFeat</basic-link> <basic-link internal-destination="TEI.geogName" text-decoration="underline">geogName</basic-link> <basic-link internal-destination="TEI.idno" text-decoration="underline">idno</basic-link> <basic-link internal-destination="TEI.langKnowledge" text-decoration="underline">langKnowledge</basic-link> <basic-link internal-destination="TEI.langKnown" text-decoration="underline">langKnown</basic-link> <basic-link internal-destination="TEI.licence" text-decoration="underline">licence</basic-link> <basic-link internal-destination="