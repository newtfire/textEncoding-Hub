<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">One or more nodes and zero or more arcs in any order.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph xml:id="cug1" type="undirected"
 order="5" size="4"
 rend="LABEL-PLACE bottom center NODE-FRAME none ARC solid line"&gt;</inline>
 <inline>&lt;label&gt;</inline>Airline Connections in Southwestern USA<inline>&lt;/label&gt;</inline>
 <inline>&lt;node xml:id="lax" degree="2"&gt;</inline>
  <inline>&lt;label&gt;</inline>LAX<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="lvg" degree="2"&gt;</inline>
  <inline>&lt;label&gt;</inline>LVG<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="phx" degree="3"&gt;</inline>
  <inline>&lt;label&gt;</inline>PHX<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="tus" degree="1"&gt;</inline>
  <inline>&lt;label&gt;</inline>TUS<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="cib" degree="0"&gt;</inline>
  <inline>&lt;label&gt;</inline>CIB<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;arc from="#lax" to="#lvg"/&gt;</inline>
 <inline>&lt;arc from="#lax" to="#phx"/&gt;</inline>
 <inline>&lt;arc from="#lvg" to="#phx"/&gt;</inline>
 <inline>&lt;arc from="#phx" to="#tus"/&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;sequence minOccurs="0"&gt;
   &lt;elementRef key="label"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
  &lt;alternate&gt;
   &lt;sequence&gt;
    &lt;sequence minOccurs="1"
     maxOccurs="unbounded"&gt;
     &lt;elementRef key="node"/&gt;
     &lt;classRef key="model.global"
      minOccurs="0" maxOccurs="unbounded"/&gt;
    &lt;/sequence&gt;
    &lt;sequence minOccurs="0"
     maxOccurs="unbounded"&gt;
     &lt;elementRef key="arc"/&gt;
     &lt;classRef key="model.global"
      minOccurs="0" maxOccurs="unbounded"/&gt;
    &lt;/sequence&gt;
   &lt;/sequence&gt;
   &lt;sequence&gt;
    &lt;sequence minOccurs="1"
     maxOccurs="unbounded"&gt;
     &lt;elementRef key="arc"/&gt;
     &lt;classRef key="model.global"
      minOccurs="0" maxOccurs="unbounded"/&gt;
    &lt;/sequence&gt;
    &lt;sequence minOccurs="1"
     maxOccurs="unbounded"&gt;
     &lt;elementRef key="node"/&gt;
     &lt;classRef key="model.global"
      minOccurs="0" maxOccurs="unbounded"/&gt;
    &lt;/sequence&gt;
   &lt;/sequence&gt;
  &lt;/alternate&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element graph
{
   tei_att.global.attributes,
   tei_att.typed.attribute.subtype,
   attribute type
   {
      "undirected" | "directed" | "transitionNetwork" | "transducer"
   }?,
   attribute order { text }?,
   attribute size { text }?,
   (
      ( ( tei_label, tei_model.global* )? ),
      (
         (
            ( ( tei_node, tei_model.global* )+ ),
            ( ( tei_arc, tei_model.global* )* )
         )
       | (
            ( ( tei_arc, tei_model.global* )+ ),
            ( ( tei_node, tei_model.global* )+ )
         )
      )
   )
}</block></block></table-cell></table-row></table-body></table>
