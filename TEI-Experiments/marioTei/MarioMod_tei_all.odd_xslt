<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;history&gt;</inline>
 <inline>&lt;origin&gt;</inline>
  <inline>&lt;p&gt;</inline>Written in Durham during the mid twelfth
     century.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/origin&gt;</inline>
 <inline>&lt;provenance&gt;</inline>
  <inline>&lt;p&gt;</inline>Recorded in two medieval
     catalogues of the books belonging to Durham Priory, made in 1391 and
     1405.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/provenance&gt;</inline>
 <inline>&lt;provenance&gt;</inline>
  <inline>&lt;p&gt;</inline>Given to W. Olleyf by William Ebchester, Prior (1446-56)
     and later belonged to Henry Dalton, Prior of Holy Island (Lindisfarne)
     according to inscriptions on ff. 4v and 5.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/provenance&gt;</inline>
 <inline>&lt;acquisition&gt;</inline>
  <inline>&lt;p&gt;</inline>Presented to Trinity College in 1738 by
     Thomas Gale and his son Roger.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/acquisition&gt;</inline>
<inline>&lt;/history&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;classRef key="model.pLike" minOccurs="1"
   maxOccurs="unbounded"/&gt;
  &lt;sequence&gt;
   &lt;elementRef key="summary" minOccurs="0"/&gt;
   &lt;elementRef key="origin" minOccurs="0"/&gt;
   &lt;elementRef key="provenance"
    minOccurs="0" maxOccurs="unbounded"/&gt;
   &lt;elementRef key="acquisition"
    minOccurs="0"/&gt;
  &lt;/sequence&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element history
{
   tei_att.global.attributes,
   (
      tei_model.pLike+
    | ( tei_summary?, tei_origin?, tei_provenance*, tei_acquisition? )
   )
}</block></block></table-cell></table-row></table-body></table>
