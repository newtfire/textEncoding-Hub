<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Where it is useful or meaningful to do so, any grouping of multiple <basic-link internal-destination="TEI.surface" text-decoration="underline">&lt;surface&gt;</basic-link> elements may be indicated using the <basic-link internal-destination="TEI.surfaceGrp" text-decoration="underline">&lt;surfaceGrp&gt;</basic-link> elements.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;sourceDoc&gt;</inline>
 <inline>&lt;surfaceGrp&gt;</inline>
  <inline>&lt;surface ulx="0" uly="0" lrx="200"
   lry="300"&gt;</inline>
   <inline>&lt;graphic url="Bovelles-49r.png"/&gt;</inline>
  <inline>&lt;/surface&gt;</inline>
  <inline>&lt;surface ulx="0" uly="0" lrx="200"
   lry="300"&gt;</inline>
   <inline>&lt;graphic url="Bovelles-49v.png"/&gt;</inline>
  <inline>&lt;/surface&gt;</inline>
 <inline>&lt;/surfaceGrp&gt;</inline>
<inline>&lt;/sourceDoc&gt;</inline></block></block></table-cell></table-row>
