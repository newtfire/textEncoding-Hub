<table-row><table-cell padding="2pt" text-align="left"><block>marks</block></table-cell><table-cell padding="2pt" text-align="left"><block>(quotation marks) indicates whether or not quotation marks have been retained as content within the text.<table text-align="left" font-size="9pt" id="d27e272954"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.enumerated" text-decoration="underline">teidata.enumerated</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Legal values are:</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="6pt" space-after="6pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">none</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>no quotation marks have been retained</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">some</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>some quotation marks have been retained</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">all</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>all quotation marks have been retained</block></list-item-body></list-item></list-block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Member of</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><basic-link internal-destination="TEI.model.editorialDeclPart" text-decoration="underline">model.editorialDeclPart</basic-link></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">header: </inline><inline><basic-link internal-destination="TEI.editorialDecl" text-decoration="underline">editorialDecl</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;quotation marks="none"&gt;</inline>
 <inline>&lt;p&gt;</inline>No quotation marks have been retained. Instead, the <inline>&lt;att&gt;</inline>rend<inline>&lt;/att&gt;</inline> attribute on the
 <inline>&lt;gi&gt;</inline>q<inline>&lt;/gi&gt;</inline> element is used to specify what kinds of quotation mark was used, according
   to the following list: <inline>&lt;list type="gloss"&gt;</inline>
   <inline>&lt;label&gt;</inline>dq<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>double quotes, open and close<inline>&lt;/item&gt;</inline>
   <inline>&lt;label&gt;</inline>sq<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>single quotes, open and close<inline>&lt;/item&gt;</inline>
   <inline>&lt;label&gt;</inline>dash<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>long dash open, no close<inline>&lt;/item&gt;</inline>
   <inline>&lt;label&gt;</inline>dg<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>double guillemets, open and close<inline>&lt;/item&gt;</inline>
  <inline>&lt;/list&gt;</inline>
 <inline>&lt;/p&gt;</inline>
<inline>&lt;/quotation&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;quotation marks="all"&gt;</inline>
 <inline>&lt;p&gt;</inline>All quotation marks are retained in the text and are represented by appropriate Unicode
   characters.<inline>&lt;/p&gt;</inline>
<inline>&lt;/quotation&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:pattern is-a="declarable"&gt;
&lt;sch:param name="tde" value="tei:quotation"/&gt;
&lt;/sch:pattern&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:rule context="tei:quotation"&gt;
&lt;sch:report test="not( @marks ) and not( tei:p )"&gt; On &lt;&lt;sch:name/&gt;&gt;, either the @marks attribute should be used, or a paragraph of description provided.
&lt;/sch:report&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;classRef key="model.pLike" minOccurs="0"
  maxOccurs="unbounded"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element quotation
{
   tei_att.global.attributes,
   tei_att.declarable.attributes,
   attribute marks { "none" | "some" | "all" }?,
   tei_model.pLike*
}</block></block></table-cell></table-row></table-body></table>
