internal-destination="TEI.collection" text-decoration="underline">collection</basic-link> <basic-link internal-destination="TEI.country" text-decoration="underline">country</basic-link> <basic-link internal-destination="TEI.death" text-decoration="underline">death</basic-link> <basic-link internal-destination="TEI.district" text-decoration="underline">district</basic-link> <basic-link internal-destination="TEI.editor" text-decoration="underline">editor</basic-link> <basic-link internal-destination="TEI.education" text-decoration="underline">education</basic-link> <basic-link internal-destination="TEI.event" text-decoration="underline">event</basic-link> <basic-link internal-destination="TEI.geogFeat" text-decoration="underline">geogFeat</basic-link> <basic-link internal-destination="TEI.geogName" text-decoration="underline">geogName</basic-link> <basic-link internal-destination="TEI.institution" text-decoration="underline">institution</basic-link> <basic-link internal-destination="TEI.nationality" text-decoration="underline">nationality</basic-link> <basic-link internal-destination="TEI.occupation" text-decoration="underline">occupation</basic-link> <basic-link internal-destination="TEI.offset" text-decoration="underline">offset</basic-link> <basic-link internal-destination="TEI.origPlace" text-decoration="underline">origPlace</basic-link> <basic-link internal-destination="TEI.population" text-decoration="underline">population</basic-link> <basic-link internal-destination="TEI.pubPlace" text-decoration="underline">pubPlace</basic-link> <basic-link internal-destination="TEI.region" text-decoration="underline">region</basic-link> <basic-link internal-destination="TEI.repository" text-decoration="underline">repository</basic-link> <basic-link internal-destination="TEI.residence" text-decoration="underline">residence</basic-link> <basic-link internal-destination="TEI.rs" text-decoration="underline">rs</basic-link> <basic-link internal-destination="TEI.settlement" text-decoration="underline">settlement</basic-link> <basic-link internal-destination="TEI.socecStatus" text-decoration="underline">socecStatus</basic-link> <basic-link internal-destination="TEI.state" text-decoration="underline">state</basic-link> <basic-link internal-destination="TEI.terrain" text-decoration="underline">terrain</basic-link> <basic-link internal-destination="TEI.trait" text-decoration="underline">trait</basic-link></inline></block></table-cell></table-row>
