 <inline>&lt;bibl&gt;</inline>
  <inline>&lt;author&gt;</inline>Craig Warner<inline>&lt;/author&gt;</inline>
  <inline>&lt;title&gt;</inline>Strangers on a Train<inline>&lt;/title&gt;</inline>
  <inline>&lt;title type="sub"&gt;</inline>Based on the novel by Patricia Highsmith<inline>&lt;/title&gt;</inline>
  <inline>&lt;edition&gt;</inline>French's acting edition<inline>&lt;/edition&gt;</inline>
  <inline>&lt;idno type="ISBN"&gt;</inline>978 0 573 01972 2<inline>&lt;/idno&gt;</inline>
  <inline>&lt;publisher&gt;</inline>Samuel French Ltd<inline>&lt;/publisher&gt;</inline>
 <inline>&lt;/bibl&gt;</inline>
<inline>&lt;/scriptStmt&gt;</inline></block></block></table-cell></table-row>
