n="TEI.body" text-decoration="underline">body</basic-link> <basic-link internal-destination="TEI.div" text-decoration="underline">div</basic-link> <basic-link internal-destination="TEI.docEdition" text-decoration="underline">docEdition</basic-link> <basic-link internal-destination="TEI.epigraph" text-decoration="underline">epigraph</basic-link> <basic-link internal-destination="TEI.imprimatur" text-decoration="underline">imprimatur</basic-link> <basic-link internal-destination="TEI.postscript" text-decoration="underline">postscript</basic-link> <basic-link internal-destination="TEI.salute" text-decoration="underline">salute</basic-link> <basic-link internal-destination="TEI.signed" text-decoration="underline">signed</basic-link> <basic-link internal-destination="TEI.titlePart" text-decoration="underline">titlePart</basic-link> <basic-link internal-destination="TEI.trailer" text-decoration="underline">trailer</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.damage" text-decoration="underline">damage</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.mod" text-decoration="underline">mod</basic-link> <basic-link internal-destination="TEI.restore" text-decoration="underline">restore</basic-link> <basic-link internal-destination="TEI.retrace" text-decoration="underline">retrace</basic-link> <basic-link internal-destination="TEI.secl" text-decoration="underline">secl</basic-link> <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link> <basic-link internal-destination="TEI.surplus" text-decoration="underline">surplus</basic-link></inline></block><block><inline font-weight="bold">verse: </inline><inline><basic-link internal-destination="TEI.rhyme" text-decoration="underline">rhyme</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.head" text-decoration="underline">head</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.app" text-decoration="underline">app</basic-link> <basic-link internal-destination="TEI.listApp" text-decoration="underline">listApp</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1"><basic-link internal-destination="TEI.listApp" text-decoration="underline">&lt;listApp&gt;</basic-link> elements would normally be located in the <basic-link internal-destination="TEI.back" text-decoration="underline">&lt;back&gt;</basic-link> part of a document, but they may appear elsewhere.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>In the following example from the exegetical Yasna, the base text is encoded in the <basic-link internal-destination="TEI.body" text-decoration="underline">&lt;body&gt;</basic-link> of the document, and two separate <basic-link internal-destination="TEI.listApp" text-decoration="underline">&lt;listApp&gt;</basic-link> elements are used in the <basic-link internal-destination="TEI.back" text-decoration="underline">&lt;back&gt;</basic-link>, containing variant readings written in different scripts.<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;body&gt;</inline>
 <inline>&lt;div&gt;</inline>
  <inline>&lt;lg type="stanza" xml:id="Y-36.01"
   xml:lang="pal-Avst" rend="italic"&gt;</inline>
   <inline>&lt;l xml:id="Y-36.01_L-1"&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-01"&gt;</inline>ahiiā<inline>&lt;/w&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-02"&gt;</inline>ϑβā<inline>&lt;/w&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-03"&gt;</inline>āϑrō<inline>&lt;/w&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-04"&gt;</inline>vərəzə̄nā<inline>&lt;/w&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-05"&gt;</inline>paouruiiē<inline>&lt;/w&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-06"&gt;</inline>pairijasāmaiδē<inline>&lt;/w&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-07"&gt;</inline>mazdā<inline>&lt;/w&gt;</inline>
    <inline>&lt;w xml:id="Y-36.01_L1_W-08"&gt;</inline>ahurā<inline>&lt;/w&gt;</inline>
   <inline>&lt;/l&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
  <inline>&lt;/lg&gt;</inline>
 <inline>&lt;/div&gt;</inline>
<inline>&lt;/body&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
<inline>&lt;back&gt;</inline>
 <inline>&lt;div&gt;</inline>
  <inline>&lt;listApp xml:id="CA_Y-36"
   xml:lang="pal-Avst"&gt;</inline>
   <inline>&lt;head&gt;</inline>Variants from witnesses in Avestan script<inline>&lt;/head&gt;</inline>
   <inline>&lt;app from="#Y-36.01_L1_W-01"&gt;</inline>
    <inline>&lt;rdg wit="#Pt4 #F2 #J2 #M1"&gt;</inline>ahiiā<inline>&lt;/rdg&gt;</inline>
   <inline>&lt;/app&gt;</inline>
   <inline>&lt;app from="#Y-36.01_L1_W-02"&gt;</inline>
    <inline>&lt;rdg wit="#Pt4 #F2 #J2 #M1"&gt;</inline>ϑβā<inline>&lt;/rdg&gt;</inline>
   <inline>&lt;/app&gt;</inline>
   <inline>&lt;app from="#Y-36.01_L1_W-03"&gt;</inline>
    <inline>&lt;rdg wit="#Pt4 #J2 #M1"&gt;</inline>āϑrō<inline>&lt;/rdg&gt;</inline>
    <inline>&lt;rdg wit="#F2"&gt;</inline>āϑrōi<inline>&lt;/rdg&gt;</inline>
   <inline>&lt;/app&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
  <inline>&lt;/listApp&gt;</inline>
  <inline>&lt;listApp xml:id="CA_PY-36"
   xml:lang="pal-Phlv"&gt;</inline>
   <inline>&lt;head&gt;</inline>Variants from witnesses written in Pahlavi script<inline>&lt;/head&gt;</inline>
   <inline>&lt;app from="#PY-36.01_L1_W-01"&gt;</inline>
    <inline>&lt;rdg wit="#Pt4 #F2 #J2 #M1"&gt;</inline>ʾytwnˈ<inline>&lt;/rdg&gt;</inline>
   <inline>&lt;/app&gt;</inline>
   <inline>&lt;app from="#PY-36.01_L1_W-02"&gt;</inline>
    <inline>&lt;rdg wit="#Pt4 #F2 #J2 #M1"&gt;</inline>ʾwˈ<inline>&lt;/rdg&gt;</inline>
   <inline>&lt;/app&gt;</inline>
   <inline>&lt;app from="#PY-36.01_L1_W-03"&gt;</inline>
    <inline>&lt;rdg wit="#Pt4 #F2 #J2 #M1"&gt;</inline>ḤNʾ<inline>&lt;/rdg&gt;</inline>
   <inline>&lt;/app&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
  <inline>&lt;/listApp&gt;</inline>
 <inline>&lt;/div&gt;</inline>
<inline>&lt;/back&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:pattern is-a="declarable"&gt;
&lt;sch:param name="tde" value="tei:listApp"/&gt;
&lt;/sch:pattern&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;classRef key="model.headLike"
   minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;elementRef key="desc" minOccurs="0"
   maxOccurs="unbounded"/&gt;
  &lt;alternate minOccurs="1"
   maxOccurs="unbounded"&gt;
   &lt;elementRef key="app"/&gt;
   &lt;elementRef key="listApp"/&gt;
  &lt;/alternate&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element listApp
{
   tei_att.global.attributes,
   tei_att.declarable.attributes,
   tei_att.sortable.attributes,
   tei_att.typed.attributes,
   ( tei_model.headLike*, desc*, ( tei_app | tei_listApp )+ )
}</block></block></table-cell></table-row></table-body></table>
