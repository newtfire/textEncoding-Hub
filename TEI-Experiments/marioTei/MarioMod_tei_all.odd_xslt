<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;recordHist&gt;</inline>
 <inline>&lt;source&gt;</inline>
  <inline>&lt;p&gt;</inline>Derived from <inline>&lt;ref target="#IMEV"&gt;</inline>IMEV 123<inline>&lt;/ref&gt;</inline> with additional research
     by P.M.W.Robinson<inline>&lt;/p&gt;</inline>
 <inline>&lt;/source&gt;</inline>
 <inline>&lt;change when="1999-06-23"&gt;</inline>
  <inline>&lt;name&gt;</inline>LDB<inline>&lt;/name&gt;</inline> (editor)
   checked examples against DTD version 3.6
 <inline>&lt;/change&gt;</inline>
<inline>&lt;/recordHist&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;classRef key="model.pLike" minOccurs="1"
   maxOccurs="unbounded"/&gt;
  &lt;sequence&gt;
   &lt;elementRef key="source"/&gt;
   &lt;elementRef key="change" minOccurs="0"
    maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element recordHist
{
   tei_att.global.attributes,
   ( tei_model.pLike+ | ( tei_source, tei_change* ) )
}</block></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.recording" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">1.326. &lt;recording&gt;</block><table text-align="left" font-size="9pt" id="d27e277239"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
