 type="structuralunit"&gt;</inline>
 <inline>&lt;desc&gt;</inline>basic structural organization<inline>&lt;/desc&gt;</inline>
 <inline>&lt;interp xml:id="I1"&gt;</inline>introduction<inline>&lt;/interp&gt;</inline>
