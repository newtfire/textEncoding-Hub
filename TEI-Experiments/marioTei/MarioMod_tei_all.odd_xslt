<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">msdescription: </inline><inline><basic-link internal-destination="TEI.objectDesc" text-decoration="underline">objectDesc</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link></inline></block><block><inline font-weight="bold">msdescription: </inline><inline><basic-link internal-destination="TEI.layout" text-decoration="underline">layout</basic-link> <basic-link internal-destination="TEI.summary" text-decoration="underline">summary</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;layoutDesc&gt;</inline>
 <inline>&lt;p&gt;</inline>Most pages have between 25 and 32 long lines ruled in lead.<inline>&lt;/p&gt;</inline>
<inline>&lt;/layoutDesc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;layoutDesc&gt;</inline>
 <inline>&lt;layout columns="2" ruledLines="42"&gt;</inline>
  <inline>&lt;p&gt;</inline>
   <inline>&lt;locus from="f12r" to="f15v"/&gt;</inline>
     2 columns of 42 lines pricked and ruled in ink, with
     central rule between the columns.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/layout&gt;</inline>
 <inline>&lt;layout columns="3"&gt;</inline>
  <inline>&lt;p&gt;</inline>
   <inline>&lt;locus from="f16"/&gt;</inline>Prickings for three columns are visible.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/layout&gt;</inline>
<inline>&lt;/layoutDesc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;classRef key="model.pLike" minOccurs="1"
   maxOccurs="unbounded"/&gt;
  &lt;sequence&gt;
   &lt;elementRef key="summary" minOccurs="0"/&gt;
   &lt;elementRef key="layout" minOccurs="1"
    maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element layoutDesc
{
   tei_att.global.attributes,
   ( tei_model.pLike+ | ( tei_summary?, tei_layout+ ) )
}</block></block></table-cell></table-row></table-body></table>
