<table-row><table-cell padding="2pt" text-align="left"><block>name</block></table-cell><table-cell padding="2pt" text-align="left"><block>a single word which follows the rules defining a legal XML name (see <basic-link external-destination="url(https://www.w3.org/TR/REC-xml/#dt-name)">https://www.w3.org/TR/REC-xml/#dt-name</basic-link>), providing a name for the feature.<table text-align="left" font-size="9pt" id="d27e104493"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><inline>Required</inline></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.name" text-decoration="underline">teidata.name</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>fVal</block></table-cell><table-cell padding="2pt" text-align="left"><block>(feature value) references any element which can be used to represent the value of a feature.<table text-align="left" font-size="9pt" id="d27e104521"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">If this attribute is supplied as well as content, the value referenced is to be unified with that contained.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.bicond" text-decoration="underline">bicond</basic-link> <basic-link internal-destination="TEI.fLib" text-decoration="underline">fLib</basic-link> <basic-link internal-destination="TEI.fs" text-decoration="underline">fs</basic-link> <basic-link internal-destination="TEI.if" text-decoration="underline">if</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.binary" text-decoration="underline">binary</basic-link> <basic-link internal-destination="TEI.default" text-decoration="underline">default</basic-link> <basic-link internal-destination="TEI.fs" text-decoration="underline">fs</basic-link> <basic-link internal-destination="TEI.numeric" text-decoration="underline">numeric</basic-link> <basic-link internal-destination="TEI.string" text-decoration="underline">string</basic-link> <basic-link internal-destination="TEI.symbol" text-decoration="underline">symbol</basic-link> <basic-link internal-destination="TEI.vAlt" text-decoration="underline">vAlt</basic-link> <basic-link internal-destination="TEI.vColl" text-decoration="underline">vColl</basic-link> <basic-link internal-destination="TEI.vLabel" text-decoration="underline">vLabel</basic-link> <basic-link internal-destination="TEI.vMerge" text-decoration="underline">vMerge</basic-link> <basic-link internal-destination="TEI.vNot" text-decoration="underline">vNot</basic-link></inline></block><block>character data</block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The content of <basic-link internal-destination="TEI.f" text-decoration="underline">&lt;f&gt;</basic-link> may be textual, with the assumption that the data type of the feature value is determined by the schema—this is the approach used in many language-technology-oriented projects and recommendations.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;f name="gender"&gt;</inline>
 <inline>&lt;symbol value="feminine"/&gt;</inline>
<inline>&lt;/f&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;fs&gt;</inline>
 <inline>&lt;f name="voice"&gt;</inline>active<inline>&lt;/f&gt;</inline>
 <inline>&lt;f name="tense"&gt;</inline>SimPre<inline>&lt;/f&gt;</inline>
<inline>&lt;/fs&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="1" maxOccurs="1"&gt;
  &lt;textNode/&gt;
  &lt;classRef key="model.featureVal"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element f
{
   tei_att.global.attributes,
   tei_att.datcat.attributes,
   attribute name { text },
   attribute fVal { text }?,
   ( text | tei_model.featureVal )
}</block></block></table-cell></table-row></table-body></table>
