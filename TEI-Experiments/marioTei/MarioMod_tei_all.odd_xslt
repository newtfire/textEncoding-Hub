<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Suggested values include:</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="6pt" space-after="6pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">sole</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>only this particular feature is used throughout the document</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">major</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>this feature is used through most of the document</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">minor</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>this feature is used occasionally through the document</block></list-item-body></list-item></list-block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;langUsage&gt;</inline>
 <inline>&lt;language ident="en"
  scope="major"/&gt;</inline>
 <inline>&lt;language ident="es"
  scope="minor"/&gt;</inline>
 <inline>&lt;language ident="x-ww"
  scope="minor"&gt;</inline>An invented language the children call <inline>&lt;name&gt;</inline>Wikwah<inline>&lt;/name&gt;</inline>.<inline>&lt;/language&gt;</inline>
<inline>&lt;/langUsage&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;handNote scope="sole"&gt;</inline>
 <inline>&lt;p&gt;</inline>Written in insular phase II half-uncial with
   interlinear Old English gloss in an Anglo-Saxon
   pointed minuscule.<inline>&lt;/p&gt;</inline>
<inline>&lt;/handNote&gt;</inline></block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.att.scoping" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">3.62. att.scoping</block><table text-align="left" font-size="9pt" id="d27e437600"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
