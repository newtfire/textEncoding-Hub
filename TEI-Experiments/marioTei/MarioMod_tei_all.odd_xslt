t</basic-link> <basic-link internal-destination="TEI.org" text-decoration="underline">org</basic-link> <basic-link internal-destination="TEI.orgName" text-decoration="underline">orgName</basic-link> <basic-link internal-destination="TEI.persName" text-decoration="underline">persName</basic-link> <basic-link internal-destination="TEI.persPronouns" text-decoration="underline">persPronouns</basic-link> <basic-link internal-destination="TEI.person" text-decoration="underline">person</basic-link> <basic-link internal-destination="TEI.personGrp" text-decoration="underline">personGrp</basic-link> <basic-link internal-destination="TEI.persona" text-decoration="underline">persona</basic-link> <basic-link internal-destination="TEI.place" text-decoration="underline">place</basic-link> <basic-link internal-destination="TEI.placeName" text-decoration="underline">placeName</basic-link> <basic-link internal-destination="TEI.region" text-decoration="underline">region</basic-link> <basic-link internal-destination="TEI.residence" text-decoration="underline">residence</basic-link> <basic-link internal-destination="TEI.roleName" text-decoration="underline">roleName</basic-link> <basic-link internal-destination="TEI.settlement" text-decoration="underline">settlement</basic-link> <basic-link internal-destination="TEI.sex" text-decoration="underline">sex</basic-link> <basic-link internal-destination="TEI.socecStatus" text-decoration="underline">socecStatus</basic-link> <basic-link internal-destination="TEI.state" text-decoration="underline">state</basic-link> <basic-link internal-destination="TEI.surname" text-decoration="underline">surname</basic-link></inline></block><block><inline font-weight="bold">spoken: </inline><inline><basic-link internal-destination="TEI.u" text-decoration="underline">u</basic-link> <basic-link internal-destination="TEI.writing" text-decoration="underline">writing</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.lem" text-decoration="underline">lem</basic-link> <basic-link internal-destination="TEI.rdg" text-decoration="underline">rdg</basic-link> <basic-link internal-destination="TEI.wit" text-decoration="underline">wit</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link> <basic-link internal-destination="TEI.witness" text-decoration="underline">witness</basic-link></inline></block><block><inline font-weight="bold">textstructure: </inline><inline><basic-link internal-destination="TEI.byline" text-decoration="underline">byline</basic-link> <basic-link internal-destination="TEI.closer" text-decoration="underline">closer</basic-link> <basic-link internal-destination="TEI.dateline" text-decoration="underline">dateline</basic-link> <basic-link internal-destination="TEI.docAuthor" text-decoration="underline">docAuthor</basic-link> <basic-link internal-destination="TEI.docDate" text-decoration="underline">docDate</basic-link> <basic-link internal-destination="TEI.docEdition" text-decoration="underline">docEdition</basic-link> <basic-link internal-destination="TEI.docImprint" text-decoration="underline">docImprint</basic-link> <basic-link internal-destination="TEI.imprimatur" text-decoration="underline">imprimatur</basic-link> <basic-link internal-destination="TEI.opener" text-decoration="underline">opener</basic-link> <basic-link internal-destination="TEI.salute" text-decoration="underline">salute</basic-link> <basic-link internal-destination="TEI.signed" text-decoration="underline">signed</basic-link> <basic-link internal-destination="TEI.titlePart" text-decoration="underline">titlePart</basic-link> <basic-link internal-destination="TEI.trailer" text-decoration="underline">trailer</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.damage" text-decoration="underline">damage</basic-link> <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.mod" text-decoration="underline">mod</basic-link> <basic-link internal-destination="TEI.restore" text-decoration="underline">restore</basic-link> <basic-link internal-destination="TEI.retrace" text-decoration="underline">retrace</basic-link> <basic-link internal-destination="TEI.secl" text-decoration="underline">secl</basic-link> <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link> <basic-link internal-destination="TEI.surplus" text-decoration="underline">surplus</basic-link></inline></block><block><inline font-weight="bold">verse: </inline><inline><basic-link internal-destination="TEI.rhyme" text-decoration="underline">rhyme</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">certainty: </inline><inline><basic-link internal-destination="TEI.precision" text-decoration="underline">precision</basic-link></inline></block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.bibl" text-decoration="underline">bibl</basic-link> <basic-link internal-destination="TEI.biblStruct" text-decoration="underline">biblStruct</basic-link> <basic-link internal-destination="TEI.head" text-decoration="underline">head</basic-link> <basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link> <basic-link internal-destination="TEI.listBibl" text-decoration="underline">listBibl</basic-link> <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link> <basic-link internal-destination="TEI.noteGrp" text-decoration="underline">noteGrp</basic-link> <basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link></inline></block><block><inline font-weight="bold">header: </inline><inline><basic-link internal-destination="TEI.biblFull" text-decoration="underline">biblFull</basic-link></inline></block><block><inline font-weight="bold">msdescription: </inline><inline><basic-link internal-destination="TEI.msDesc" text-decoration="underline">msDesc</basic-link></inline></block><block><inline font-weight="bold">namesdates: </inline><inline><basic-link internal-destination="TEI.state" text-decoration="underline">state</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Where there is confusion between <basic-link internal-destination="TEI.trait" text-decoration="underline">&lt;trait&gt;</basic-link> and <basic-link internal-destination="TEI.state" text-decoration="underline">&lt;state&gt;</basic-link> the more general purpose element <basic-link internal-destination="TEI.state" text-decoration="underline">&lt;state&gt;</basic-link> should be used even for unchanging characteristics. If you wish to distinguish between characteristics that are generally perceived to be time-bound states and those assumed to be fixed traits, then <basic-link internal-destination="TEI.trait" text-decoration="underline">&lt;trait&gt;</basic-link> is available for the more static of these. The <basic-link internal-destination="TEI.state" text-decoration="underline">&lt;state&gt;</basic-link> element encodes characteristics which are sometimes assumed to change, often at specific times or over a date range, whereas the <basic-link internal-destination="TEI.trait" text-decoration="underline">&lt;trait&gt;</basic-link> elements are used to record characteristics, such as eye-colour, which are less subject to change. Traits are typically, but not necessarily, independent of the volition or action of the holder.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;state ref="#SCHOL" type="status"&gt;</inline>
 <inline>&lt;label&gt;</inline>scholar<inline>&lt;/label&gt;</inline>
<inline>&lt;/state&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;org&gt;</inline>
 <inline>&lt;orgName notAfter="1960"&gt;</inline>The Silver Beetles<inline>&lt;/orgName&gt;</inline>
 <inline>&lt;orgName notBefore="1960"&gt;</inline>The Beatles<inline>&lt;/orgName&gt;</inline>
 <inline>&lt;state type="membership" from="1960-08"
  to="1962-05"&gt;</inline>
  <inline>&lt;desc&gt;</inline>
   <inline>&lt;persName&gt;</inline>John Lennon<inline>&lt;/persName&gt;</inline>
   <inline>&lt;persName&gt;</inline>Paul McCartney<inline>&lt;/persName&gt;</inline>
   <inline>&lt;persName&gt;</inline>George Harrison<inline>&lt;/persName&gt;</inline>
   <inline>&lt;persName&gt;</inline>Stuart Sutcliffe<inline>&lt;/persName&gt;</inline>
   <inline>&lt;persName&gt;</inline>Pete Best<inline>&lt;/persName&gt;</inline>
  <inline>&lt;/desc&gt;</inline>
 <inline>&lt;/state&gt;</inline>
 <inline>&lt;state type="membership" notBefore="1963"&gt;</inline>
  <inline>&lt;desc&gt;</inline>
   <inline>&lt;persName&gt;</inline>John Lennon<inline>&lt;/persName&gt;</inline>
   <inline>&lt;persName&gt;</inline>Paul McCartney<inline>&lt;/persName&gt;</inline>
   <inline>&lt;persName&gt;</inline>George Harrison<inline>&lt;/persName&gt;</inline>
   <inline>&lt;persName&gt;</inline>Ringo Starr<inline>&lt;/persName&gt;</inline>
  <inline>&lt;/desc&gt;</inline>
 <inline>&lt;/state&gt;</inline>
<inline>&lt;/org&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;elementRef key="precision" minOccurs="0"
   maxOccurs="unbounded"/&gt;
  &lt;alternate&gt;
   &lt;elementRef key="state" minOccurs="1"
    maxOccurs="unbounded"/&gt;
   &lt;sequence&gt;
    &lt;classRef key="model.headLike"
     minOccurs="0" maxOccurs="unbounded"/&gt;
    &lt;classRef key="model.pLike"
     minOccurs="1" maxOccurs="unbounded"/&gt;
    &lt;alternate minOccurs="0"
     maxOccurs="unbounded"&gt;
     &lt;classRef key="model.noteLike"/&gt;
     &lt;classRef key="model.biblLike"/&gt;
    &lt;/alternate&gt;
   &lt;/sequence&gt;
   &lt;alternate minOccurs="0"
    maxOccurs="unbounded"&gt;
    &lt;classRef key="model.labelLike"/&gt;
    &lt;classRef key="model.noteLike"/&gt;
    &lt;classRef key="model.biblLike"/&gt;
   &lt;/alternate&gt;
  &lt;/alternate&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element state
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.datable.attributes,
   tei_att.dimensions.attributes,
   tei_att.editLike.attributes,
   tei_att.naming.attributes,
   tei_att.typed.attributes,
   (
      tei_precision*,
      (
         tei_state+
       | (
            tei_model.headLike*,
            tei_model.pLike+,
            ( tei_model.noteLike | tei_model.biblLike )*
         )
       | ( tei_model.labelLike | tei_model.noteLike | tei_model.biblLike )*
      )
   )
}</block></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.stdVals" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">1.395. &lt;stdVals&gt;</block><table text-align="left" font-size="9pt" id="d27e341773"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
