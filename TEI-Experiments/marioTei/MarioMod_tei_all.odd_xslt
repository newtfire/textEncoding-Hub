<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Prose and a mixture of speech elements</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">Although individual transcriptions may consistently use <basic-link internal-destination="TEI.u" text-decoration="underline">&lt;u&gt;</basic-link> elements for turns or other units, and although in most cases a <basic-link internal-destination="TEI.u" text-decoration="underline">&lt;u&gt;</basic-link> will be delimited by pause or change of speaker, <basic-link internal-destination="TEI.u" text-decoration="underline">&lt;u&gt;</basic-link> is not required to represent a turn or any communicative event, nor to be bounded by pauses or change of speaker. At a minimum, a <basic-link internal-destination="TEI.u" text-decoration="underline">&lt;u&gt;</basic-link> is some phonetic production by a given speaker.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;u who="#spkr1"&gt;</inline>if did you set<inline>&lt;/u&gt;</inline>
<inline>&lt;u trans="latching" who="#spkr2"&gt;</inline>well Joe and I set it between us<inline>&lt;/u&gt;</inline>
<inline>&lt;list type="speakers"&gt;</inline>
 <inline>&lt;item xml:id="spkr1"/&gt;</inline>
 <inline>&lt;item xml:id="spkr2"/&gt;</inline>
<inline>&lt;/list&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.paraContent"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element u
{
   tei_att.global.attributes,
   tei_att.ascribed.directed.attributes,
   tei_att.declaring.attributes,
   tei_att.notated.attributes,
   tei_att.timed.attributes,
   attribute trans { "smooth" | "latching" | "overlap" | "pause" }?,
   tei_macro.paraContent
}</block></block></table-cell></table-row></table-body></table>
