 <inline>&lt;/langUsage&gt;</inline>
 <inline>&lt;textDesc n="novel"&gt;</inline>
  <inline>&lt;channel mode="w"&gt;</inline>print; part issues<inline>&lt;/channel&gt;</inline>
  <inline>&lt;constitution type="single"/&gt;</inline>
  <inline>&lt;derivation type="original"/&gt;</inline>
  <inline>&lt;domain type="art"/&gt;</inline>
  <inline>&lt;factuality type="fiction"/&gt;</inline>
  <inline>&lt;interaction type="none"/&gt;</inline>
  <inline>&lt;preparedness type="prepared"/&gt;</inline>
  <inline>&lt;purpose type="entertain" degree="high"/&gt;</inline>
