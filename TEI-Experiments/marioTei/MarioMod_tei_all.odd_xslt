pose" text-decoration="underline">listTranspose</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.space" text-decoration="underline">space</basic-link> <basic-link internal-destination="TEI.substJoin" text-decoration="underline">substJoin</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Contains optional headings, a sequence of one or more component-level elements, and an optional sequence of closing material.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt"/></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;epilogue&gt;</inline>
 <inline>&lt;head&gt;</inline>Written by <inline>&lt;name&gt;</inline>Colley Cibber, Esq<inline>&lt;/name&gt;</inline> and spoken by <inline>&lt;name&gt;</inline>Mrs. Cibber<inline>&lt;/name&gt;</inline>
 <inline>&lt;/head&gt;</inline>
 <inline>&lt;sp&gt;</inline>
  <inline>&lt;lg type="couplet"&gt;</inline>
   <inline>&lt;l&gt;</inline>Since Fate has robb'd me of the hapless Youth,<inline>&lt;/l&gt;</inline>
   <inline>&lt;l&gt;</inline>For whom my heart had hoarded up its truth;<inline>&lt;/l&gt;</inline>
  <inline>&lt;/lg&gt;</inline>
  <inline>&lt;lg type="couplet"&gt;</inline>
   <inline>&lt;l&gt;</inline>By all the Laws of Love and Honour, now,<inline>&lt;/l&gt;</inline>
   <inline>&lt;l&gt;</inline>I'm free again to chuse, — and one of you<inline>&lt;/l&gt;</inline>
  <inline>&lt;/lg&gt;</inline>
  <inline>&lt;lg type="triplet"&gt;</inline>
   <inline>&lt;l&gt;</inline>Suppose I search the sober Gallery; — No,<inline>&lt;/l&gt;</inline>
   <inline>&lt;l&gt;</inline>There's none but Prentices — &amp;amp; Cuckolds all a row:<inline>&lt;/l&gt;</inline>
   <inline>&lt;l&gt;</inline>And these, I doubt, are those that make 'em so.<inline>&lt;/l&gt;</inline>
  <inline>&lt;/lg&gt;</inline>
  <inline>&lt;stage type="business"&gt;</inline>Pointing to the Boxes.<inline>&lt;/stage&gt;</inline>
  <inline>&lt;lg type="couplet"&gt;</inline>
   <inline>&lt;l&gt;</inline>'Tis very well, enjoy the jest:<inline>&lt;/l&gt;</inline>
  <inline>&lt;/lg&gt;</inline>
 <inline>&lt;/sp&gt;</inline>
<inline>&lt;/epilogue&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.divTop"/&gt;
   &lt;classRef key="model.global"/&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="1"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.common"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
  &lt;sequence minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.divBottom"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element epilogue
{
   tei_att.global.attributes,
   (
      ( tei_model.divTop | tei_model.global )*,
      ( ( tei_model.common, tei_model.global* )+ ),
      ( ( tei_model.divBottom, tei_model.global* )* )
   )
}</block></block></table-cell></table-row></table-body></table>
