<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Addresses may be encoded either as a sequence of lines, or using any sequence of component elements from the <inline color="black" font-family="Helvetica">model.addrPart</inline> class. Other non-postal forms of address, such as telephone numbers or email, should not be included within an <basic-link internal-destination="TEI.address" text-decoration="underline">&lt;address&gt;</basic-link> element directly but may be wrapped within an <basic-link internal-destination="TEI.addrLine" text-decoration="underline">&lt;addrLine&gt;</basic-link> if they form part of the printed address in some source text.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;address&gt;</inline>
 <inline>&lt;addrLine&gt;</inline>Computing Center, MC 135<inline>&lt;/addrLine&gt;</inline>
 <inline>&lt;addrLine&gt;</inline>P.O. Box 6998<inline>&lt;/addrLine&gt;</inline>
 <inline>&lt;addrLine&gt;</inline>Chicago, IL<inline>&lt;/addrLine&gt;</inline>
 <inline>&lt;addrLine&gt;</inline>60680 USA<inline>&lt;/addrLine&gt;</inline>
<inline>&lt;/address&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;addrLine&gt;</inline>
 <inline>&lt;ref target="tel:+1-201-555-0123"&gt;</inline>(201) 555 0123<inline>&lt;/ref&gt;</inline>
<inline>&lt;/addrLine&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.phraseSeq"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element addrLine { tei_att.global.attributes, tei_macro.phraseSeq }</block></block></table-cell></table-row></table-body></table>
