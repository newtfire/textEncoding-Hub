 <inline>&lt;localProp name="Name"
  value="LATIN SMALL LETTER R WITH A FUNNY STROKE"/&gt;</inline>
 <inline>&lt;localProp name="entity" value="rstroke"/&gt;</inline>
 <inline>&lt;figure&gt;</inline>
