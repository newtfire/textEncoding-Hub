<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">The value for this attribute should be a language ‘tag’ as defined in <basic-link external-destination="url(https://tools.ietf.org/html/bcp47)">BCP 47</basic-link>.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
