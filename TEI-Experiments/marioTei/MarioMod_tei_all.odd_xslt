 <inline>&lt;fDescr&gt;</inline>inverted sentence<inline>&lt;/fDescr&gt;</inline>
 <inline>&lt;vRange&gt;</inline>
  <inline>&lt;vAlt&gt;</inline>
   <inline>&lt;binary value="true"/&gt;</inline>
   <inline>&lt;binary value="false"/&gt;</inline>
  <inline>&lt;/vAlt&gt;</inline>
 <inline>&lt;/vRange&gt;</inline>
 <inline>&lt;vDefault&gt;</inline>
  <inline>&lt;binary value="false"/&gt;</inline>
 <inline>&lt;/vDefault&gt;</inline>
<inline>&lt;/fDecl&gt;</inline></block></block></table-cell></table-row>
