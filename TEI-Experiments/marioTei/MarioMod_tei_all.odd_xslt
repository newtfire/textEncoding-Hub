<table-row><table-cell padding="2pt" text-align="left"><block>role</block></table-cell><table-cell padding="2pt" text-align="left"><block>specifies the role of this group of participants in the interaction.<table text-align="left" font-size="9pt" id="d27e253880"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
