<inline>&lt;/performance&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
<inline>&lt;stage type="entrance"&gt;</inline>
 <inline>&lt;move who="#bellaf" type="enter" where="L"
  perf="#perf1"/&gt;</inline> Enter
 Bellafront mad.
<inline>&lt;/stage&gt;</inline></block></block></table-cell></table-row>
