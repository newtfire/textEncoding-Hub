<table-row><table-cell number-columns-spanned="2" border-before-style="solid" border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">att.rdgPart</inline> provides attributes to mark the beginning or ending of a fragmentary manuscript or other witness. [<basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/TC.html#TCAPMI)">13.1.5. Fragmentary Witnesses</basic-link>]</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Module</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>textcrit</block></table-cell></table-row>
