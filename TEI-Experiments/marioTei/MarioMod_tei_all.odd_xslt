<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The <basic-link internal-destination="TEI.witDetail" text-decoration="underline">&lt;witDetail&gt;</basic-link> element was formerly permitted anywhere that <basic-link internal-destination="TEI.note" text-decoration="underline">&lt;note&gt;</basic-link> could appear, but since it should only be used in association with <basic-link internal-destination="TEI.lem" text-decoration="underline">&lt;lem&gt;</basic-link> and <basic-link internal-destination="TEI.rdg" text-decoration="underline">&lt;rdg&gt;</basic-link>, it is recommended that it be placed immediately following the reading that it modifies, in the same <basic-link internal-destination="TEI.app" text-decoration="underline">&lt;app&gt;</basic-link>. A <basic-link internal-destination="TEI.witDetail" text-decoration="underline">&lt;witDetail&gt;</basic-link> without a <inline font-style="italic">target</inline> attribute should be assumed to refer to the closest preceding <basic-link internal-destination="TEI.lem" text-decoration="underline">&lt;lem&gt;</basic-link> or <basic-link internal-destination="TEI.rdg" text-decoration="underline">&lt;rdg&gt;</basic-link>.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;app type="substantive"&gt;</inline>
 <inline>&lt;lem xml:id="W026x" wit="#El #HG"&gt;</inline>Experience<inline>&lt;/lem&gt;</inline>
 <inline>&lt;rdg wit="#Ha4"&gt;</inline>Experiens<inline>&lt;/rdg&gt;</inline>
 <inline>&lt;witDetail target="#W026x" resp="#PR"
  wit="#El" type="presentation"&gt;</inline>Ornamental capital.<inline>&lt;/witDetail&gt;</inline>
<inline>&lt;/app&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="0"
  maxOccurs="unbounded"&gt;
  &lt;textNode/&gt;
  &lt;classRef key="model.gLike"/&gt;
  &lt;classRef key="model.phrase"/&gt;
  &lt;classRef key="model.global"/&gt;
  &lt;elementRef key="bibl"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element witDetail
{
   tei_att.global.attributes,
   tei_att.placement.attributes,
   tei_att.pointing.attributes,
   tei_att.typed.attribute.subtype,
   attribute type { text }?,
   attribute wit { list { + } },
   ( text | tei_model.gLike | tei_model.phrase | tei_model.global | tei_bibl )*
}</block></block></table-cell></table-row></table-body></table>
