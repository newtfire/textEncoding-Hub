<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Each individual keyword (including compound subject headings) should be supplied as a <basic-link internal-destination="TEI.term" text-decoration="underline">&lt;term&gt;</basic-link> element directly within the <basic-link internal-destination="TEI.keywords" text-decoration="underline">&lt;keywords&gt;</basic-link> element. An alternative usage, in which each <basic-link internal-destination="TEI.term" text-decoration="underline">&lt;term&gt;</basic-link> appears within an <basic-link internal-destination="TEI.item" text-decoration="underline">&lt;item&gt;</basic-link> inside a <basic-link internal-destination="TEI.list" text-decoration="underline">&lt;list&gt;</basic-link> is permitted for backwards compatibility, but is deprecated.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">If no control list exists for the keywords used, then no value should be supplied for the <inline font-style="italic">scheme</inline> attribute.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;keywords scheme="http://classificationweb.net"&gt;</inline>
 <inline>&lt;term&gt;</inline>Babbage, Charles<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Mathematicians - Great Britain - Biography<inline>&lt;/term&gt;</inline>
<inline>&lt;/keywords&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;keywords&gt;</inline>
 <inline>&lt;term&gt;</inline>Fermented beverages<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Central Andes<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Schinus molle<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Molle beer<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Indigenous peoples<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Ethnography<inline>&lt;/term&gt;</inline>
 <inline>&lt;term&gt;</inline>Archaeology<inline>&lt;/term&gt;</inline>
<inline>&lt;/keywords&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;elementRef key="term" minOccurs="1"
   maxOccurs="unbounded"/&gt;
  &lt;elementRef key="list"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element keywords
{
   tei_att.global.attributes,
   attribute scheme { text }?,
