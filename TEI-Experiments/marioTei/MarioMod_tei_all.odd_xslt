<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;date xml:id="date001" notBefore="0014"
 notAfter="0064"&gt;</inline>Within about 50
 years of the death of Augustus<inline>&lt;/date&gt;</inline>
<inline>&lt;precision target="#date001"
 match="@notBefore" precision="high"/&gt;</inline>
<inline>&lt;precision target="#date001"
 match="@notAfter" precision="low"/&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;date notBefore="1632" notAfter="1642"&gt;</inline>Not more than ten years before the start of the Civil War
<inline>&lt;precision match="@notBefore"
  precision="low"/&gt;</inline>
 <inline>&lt;precision match="@notAfter"
  precision="high"/&gt;</inline>
<inline>&lt;/date&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="0"
  maxOccurs="unbounded"&gt;
  &lt;classRef key="model.descLike"/&gt;
  &lt;classRef key="model.certLike"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element precision
{
   tei_att.global.attributes,
   tei_att.datable.attributes,
   tei_att.ranging.attributes,
   tei_att.scoping.attributes,
   attribute precision { text }?,
   attribute stdDeviation { text }?,
   ( tei_model.descLike | tei_model.certLike )*
}</block></block></table-cell></table-row></table-body></table>
