<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;opener&gt;</inline>
 <inline>&lt;dateline&gt;</inline>Walden, this 29. of August 1592<inline>&lt;/dateline&gt;</inline>
<inline>&lt;/opener&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;opener&gt;</inline>
 <inline>&lt;dateline&gt;</inline>
  <inline>&lt;name type="place"&gt;</inline>Great Marlborough Street<inline>&lt;/name&gt;</inline>
  <inline>&lt;date&gt;</inline>November 11, 1848<inline>&lt;/date&gt;</inline>
 <inline>&lt;/dateline&gt;</inline>
 <inline>&lt;salute&gt;</inline>My dear Sir,<inline>&lt;/salute&gt;</inline>
<inline>&lt;/opener&gt;</inline>
<inline>&lt;p&gt;</inline>I am sorry to say that absence from town and other circumstances have prevented me from
 earlier enquiring...<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="0"
  maxOccurs="unbounded"&gt;
  &lt;textNode/&gt;
  &lt;classRef key="model.gLike"/&gt;
  &lt;classRef key="model.phrase"/&gt;
  &lt;elementRef key="argument"/&gt;
  &lt;elementRef key="byline"/&gt;
  &lt;elementRef key="dateline"/&gt;
  &lt;elementRef key="epigraph"/&gt;
  &lt;elementRef key="salute"/&gt;
  &lt;elementRef key="signed"/&gt;
  &lt;classRef key="model.global"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element opener
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.written.attributes,
   (
      text
    | tei_model.gLike
    | tei_model.phrase
    | tei_argument
    | tei_byline
    | tei_dateline
    | tei_epigraph
    | tei_salute
    | tei_signed
    | tei_model.global
   )*
}</block></block></table-cell></table-row></table-body></table>
