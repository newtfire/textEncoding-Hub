<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;additional&gt;</inline>
 <inline>&lt;adminInfo&gt;</inline>
  <inline>&lt;recordHist&gt;</inline>
   <inline>&lt;p&gt;</inline>
<inline>&lt;!-- record history here --&gt;</inline>
   <inline>&lt;/p&gt;</inline>
  <inline>&lt;/recordHist&gt;</inline>
  <inline>&lt;custodialHist&gt;</inline>
   <inline>&lt;p&gt;</inline>
<inline>&lt;!-- custodial history here --&gt;</inline>
   <inline>&lt;/p&gt;</inline>
  <inline>&lt;/custodialHist&gt;</inline>
 <inline>&lt;/adminInfo&gt;</inline>
 <inline>&lt;surrogates&gt;</inline>
  <inline>&lt;p&gt;</inline>
<inline>&lt;!-- information about surrogates here --&gt;</inline>
  <inline>&lt;/p&gt;</inline>
 <inline>&lt;/surrogates&gt;</inline>
 <inline>&lt;listBibl&gt;</inline>
  <inline>&lt;bibl&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
  <inline>&lt;/bibl&gt;</inline>
<inline>&lt;!-- full bibliography here --&gt;</inline>
 <inline>&lt;/listBibl&gt;</inline>
<inline>&lt;/additional&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;sequence&gt;
   &lt;elementRef key="adminInfo"
    minOccurs="0"/&gt;
   &lt;elementRef key="surrogates"
    minOccurs="0"/&gt;
   &lt;elementRef key="listBibl" minOccurs="0"/&gt;
  &lt;/sequence&gt;
  &lt;classRef key="model.pLike" minOccurs="1"
   maxOccurs="unbounded"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element additional
{
   tei_att.global.attributes,
   ( ( tei_adminInfo?, tei_surrogates?, tei_listBibl? ) | tei_model.pLike+ )
