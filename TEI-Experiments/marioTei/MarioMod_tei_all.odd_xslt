<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Detailed analyses of quantities and units of measure in historical documents may also use the feature structure mechanism described in chapter <basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/FS.html#FS)">19. Feature Structures</basic-link>. The <basic-link internal-destination="TEI.num" text-decoration="underline">&lt;num&gt;</basic-link> element is intended for use in simple applications.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;p&gt;</inline>I reached <inline>&lt;num type="cardinal" value="21"&gt;</inline>twenty-one<inline>&lt;/num&gt;</inline> on
 my <inline>&lt;num type="ordinal" value="21"&gt;</inline>twenty-first<inline>&lt;/num&gt;</inline> birthday<inline>&lt;/p&gt;</inline>
<inline>&lt;p&gt;</inline>Light travels at <inline>&lt;num value="3E10"&gt;</inline>3×10<inline>&lt;hi rend="sup"&gt;</inline>10<inline>&lt;/hi&gt;</inline>
 <inline>&lt;/num&gt;</inline> cm per second.<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.phraseSeq"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element num
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.ranging.attributes,
   tei_att.typed.attribute.subtype,
   attribute type { "cardinal" | "ordinal" | "fraction" | "percentage" }?,
   attribute value { text }?,
   tei_macro.phraseSeq
}</block></block></table-cell></table-row></table-body></table>
