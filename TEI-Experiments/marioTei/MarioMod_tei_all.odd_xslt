="TEI.rs" text-decoration="underline">rs</basic-link> <basic-link internal-destination="TEI.settlement" text-decoration="underline">settlement</basic-link> <basic-link internal-destination="TEI.socecStatus" text-decoration="underline">socecStatus</basic-link> <basic-link internal-destination="TEI.state" text-decoration="underline">state</basic-link> <basic-link internal-destination="TEI.terrain" text-decoration="underline">terrain</basic-link> <basic-link internal-destination="TEI.trait" text-decoration="underline">trait</basic-link>]</inline> <basic-link internal-destination="TEI.address" text-decoration="underline">address</basic-link> <basic-link internal-destination="TEI.authority" text-decoration="underline">authority</basic-link> <basic-link internal-destination="TEI.bibl" text-decoration="underline">bibl</basic-link> <basic-link internal-destination="TEI.biblFull" text-decoration="underline">biblFull</basic-link> <basic-link internal-destination="TEI.biblStruct" text-decoration="underline">biblStruct</basic-link> <basic-link internal-destination="TEI.catDesc" text-decoration="underline">catDesc</basic-link> <basic-link internal-destination="TEI.correspDesc" text-decoration="underline">correspDesc</basic-link> <basic-link internal-destination="TEI.distributor" text-decoration="underline">distributor</basic-link> <basic-link internal-destination="TEI.docAuthor" text-decoration="underline">docAuthor</basic-link> <basic-link internal-destination="TEI.docTitle" text-decoration="underline">docTitle</basic-link> <basic-link internal-destination="TEI.faith" text-decoration="underline">faith</basic-link> <basic-link internal-destination="TEI.funder" text-decoration="underline">funder</basic-link> <basic-link internal-destination="TEI.material" text-decoration="underline">material</basic-link> <basic-link internal-destination="TEI.meeting" text-decoration="underline">meeting</basic-link> <basic-link internal-destination="TEI.object" text-decoration="underline">object</