<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;bibl&gt;</inline>
 <inline>&lt;title level="a"&gt;</inline>The Interesting story of the Children in the Wood<inline>&lt;/title&gt;</inline>. In
<inline>&lt;author&gt;</inline>Victor E Neuberg<inline>&lt;/author&gt;</inline>, <inline>&lt;title&gt;</inline>The Penny Histories<inline>&lt;/title&gt;</inline>.
<inline>&lt;publisher&gt;</inline>OUP<inline>&lt;/publisher&gt;</inline>
 <inline>&lt;date&gt;</inline>1968<inline>&lt;/date&gt;</inline>. 
<inline>&lt;/bibl&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;bibl type="article" subtype="book_chapter"
 xml:id="carlin_2003"&gt;</inline>
 <inline>&lt;author&gt;</inline>
  <inline>&lt;name&gt;</inline>
   <inline>&lt;surname&gt;</inline>Carlin<inline>&lt;/surname&gt;</inline>
     (<inline>&lt;forename&gt;</inline>Claire<inline>&lt;/forename&gt;</inline>)<inline>&lt;/name&gt;</inline>
 <inline>&lt;/author&gt;</inline>,
<inline>&lt;title level="a"&gt;</inline>The Staging of Impotence : France’s last
   congrès<inline>&lt;/title&gt;</inline> dans
<inline>&lt;bibl type="monogr"&gt;</inline>
  <inline>&lt;title level="m"&gt;</inline>Theatrum mundi : studies in honor of Ronald W.
     Tobin<inline>&lt;/title&gt;</inline>, éd.
 <inline>&lt;editor&gt;</inline>
   <inline>&lt;name&gt;</inline>
    <inline>&lt;forename&gt;</inline>Claire<inline>&lt;/forename&gt;</inline>
    <inline>&lt;surname&gt;</inline>Carlin<inline>&lt;/surname&gt;</inline>
   <inline>&lt;/name&gt;</inline>
  <inline>&lt;/editor&gt;</inline> et
 <inline>&lt;editor&gt;</inline>
   <inline>&lt;name&gt;</inline>
    <inline>&lt;forename&gt;</inline>Kathleen<inline>&lt;/forename&gt;</inline>
    <inline>&lt;surname&gt;</inline>Wine<inline>&lt;/surname&gt;</inline>
   <inline>&lt;/name&gt;</inline>
  <inline>&lt;/editor&gt;</inline>,
 <inline>&lt;pubPlace&gt;</inline>Charlottesville, Va.<inline>&lt;/pubPlace&gt;</inline>,
 <inline>&lt;publisher&gt;</inline>Rookwood Press<inline>&lt;/publisher&gt;</inline>,
 <inline>&lt;date when="2003"&gt;</inline>2003<inline>&lt;/date&gt;</inline>.
 <inline>&lt;/bibl&gt;</inline>
<inline>&lt;/bibl&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
