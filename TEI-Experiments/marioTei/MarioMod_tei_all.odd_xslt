<table-row><table-cell padding="2pt" text-align="left"><block>org</block></table-cell><table-cell padding="2pt" text-align="left"><block>indicates the organization of the resulting merged values as set, bag or list.<table text-align="left" font-size="9pt" id="d27e384157"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.enumerated" text-decoration="underline">teidata.enumerated</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Legal values are:</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="6pt" space-after="6pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">set</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>indicates that the resulting values are organized as a set.</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">bag</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>indicates that the resulting values are organized as a bag (multiset).</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">list</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>indicates that the resulting values are organized as a list.</block></list-item-body></list-item></list-block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
