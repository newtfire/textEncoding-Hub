nderline">gap</basic-link> <basic-link internal-destination="TEI.gb" text-decoration="underline">gb</basic-link> <basic-link internal-destination="TEI.graphic" text-decoration="underline">graphic</basic-link> <basic-link internal-destination="TEI.hi" text-decoration="underline">hi</basic-link> <basic-link internal-destination="TEI.index" text-decoration="underline">index</basic-link> <basic-link internal-destination="TEI.lb" text-decoration="underline">lb</basic-link> <basic-link internal-destination="TEI.media" text-decoration="underline">media</basic-link> <basic-link internal-destination="TEI.milestone" text-decoration="underline">milestone</basic-link> <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link> <basic-link internal-destination="TEI.noteGrp" text-decoration="underline">noteGrp</basic-link> <basic-link internal-destination="TEI.pb" text-decoration="underline">pb</basic-link> <basic-link internal-destination="TEI.q" text-decoration="underline">q</basic-link> <basic-link internal-destination="TEI.unclear" text-decoration="underline">unclear</basic-link></inline></block><block><inline font-weight="bold">figures: </inline><inline><basic-link internal-destination="TEI.figure" text-decoration="underline">figure</basic-link> <basic-link internal-destination="TEI.formula" text-decoration="underline">formula</basic-link> <basic-link internal-destination="TEI.notatedMusic" text-decoration="underline">notatedMusic</basic-link></inline></block><block><inline font-weight="bold">gaiji: </inline><inline><basic-link internal-destination="TEI.g" text-decoration="underline">g</basic-link></inline></block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.fLib" text-decoration="underline">fLib</basic-link> <basic-link internal-destination="TEI.fs" text-decoration="underline">fs</basic-link> <basic-link internal-destination="TEI.fvLib" text-decoration="underline">fvLib</basic-link></inline></block><block><inline font-weight="bold">spoken: </inline><inline><basic-link internal-destination="TEI.incident" text-decoration="underline">incident</basic-link> <basic-link internal-destination="TEI.kinesic" text-decoration="underline">kinesic</basic-link> <basic-link internal-destination="TEI.pause" text-decoration="underline">pause</basic-link> <basic-link internal-destination="TEI.shift" text-decoration="underline">shift</basic-link> <basic-link internal-destination="TEI.vocal" text-decoration="underline">vocal</basic-link> <basic-link internal-destination="TEI.writing" text-decoration="underline">writing</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.app" text-decoration="underline">app</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.addSpan" text-decoration="underline">addSpan</basic-link> <basic-link internal-destination="TEI.damage" text-decoration="underline">damage</basic-link> <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">damageSpan</basic-link> <basic-link internal-destination="TEI.delSpan" text-decoration="underline">delSpan</basic-link> <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link> <basic-link internal-destination="TEI.handShift" text-decoration="underline">handShift</basic-link> <basic-link internal-destination="TEI.line" text-decoration="underline">line</basic-link> <basic-link internal-destination="TEI.listTranspose" text-decoration="underline">listTranspose</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.mod" text-decoration="underline">mod</basic-link> <basic-link internal-destination="TEI.path" text-decoration="underline">path</basic-link> <basic-link internal-destination="TEI.redo" text-decoration="underline">redo</basic-link> <basic-link internal-destination="TEI.restore" text-decoration="underline">restore</basic-link> <basic-link internal-destination="TEI.retrace" text-decoration="underline">retrace</basic-link> <basic-link internal-destination="TEI.space" text-decoration="underline">space</basic-link> <basic-link internal-destination="TEI.substJoin" text-decoration="underline">substJoin</basic-link> <basic-link internal-destination="TEI.surface" text-decoration="underline">surface</basic-link> <basic-link internal-destination="TEI.undo" text-decoration="underline">undo</basic-link> <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link></inline></block><block>character data</block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The position of every zone for a given surface is always defined by reference to the coordinate system defined for that surface. </block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">A graphic element contained by a zone represents the whole of the zone.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">A zone may be of any shape. The attribute <inline font-style="italic">points</inline> may be used to define a polygonal zone, using the coordinate system defined by its parent surface.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">A zone is always a closed polygon. Repeating the initial coordinate at the end of the sequence is optional. To encode an unclosed path, use the <basic-link internal-destination="TEI.path" text-decoration="underline">&lt;path&gt;</basic-link> element.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;surface ulx="14.54" uly="16.14" lrx="0"
 lry="0"&gt;</inline>
 <inline>&lt;graphic url="stone.jpg"/&gt;</inline>
 <inline>&lt;zone points="4.6,6.3 5.25,5.85 6.2,6.6 8.19222,7.4125 9.89222,6.5875 10.9422,6.1375 
 11.4422,6.7125 8.21722,8.3125 6.2,7.65"/&gt;</inline>
<inline>&lt;/surface&gt;</inline></block>This example defines a non-rectangular zone: see the illustration in section .</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;facsimile&gt;</inline>
 <inline>&lt;surface ulx="50" uly="20" lrx="400"
  lry="280"&gt;</inline>
  <inline>&lt;zone ulx="0" uly="0" lrx="500" lry="321"&gt;</inline>
   <inline>&lt;graphic url="graphic.png"/&gt;</inline>
  <inline>&lt;/zone&gt;</inline>
 <inline>&lt;/surface&gt;</inline>
<inline>&lt;/facsimile&gt;</inline></block>This example defines a zone which has been defined as larger than its parent surface in order to match the dimensions of the graphic it contains.</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="0"
  maxOccurs="unbounded"&gt;
  &lt;textNode/&gt;
  &lt;classRef key="model.gLike"/&gt;
  &lt;classRef key="model.graphicLike"/&gt;
  &lt;classRef key="model.global"/&gt;
  &lt;elementRef key="surface"/&gt;
  &lt;classRef key="model.linePart"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element zone
{
   tei_att.global.attributes,
   tei_att.coordinated.attributes,
   tei_att.typed.attributes,
   tei_att.written.attributes,
   attribute rotate { text }?,
   (
      text
    | tei_model.gLike
    | tei_model.graphicLike
    | tei_model.global
    | tei_surface
    | tei_model.linePart
   )*
}</block></block></table-cell></table-row></table-body></table>
