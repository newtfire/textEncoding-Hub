<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Character data only</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Uses of <basic-link internal-destination="TEI.geo" text-decoration="underline">&lt;geo&gt;</basic-link> can be associated with a coordinate system, defined by a <basic-link internal-destination="TEI.geoDecl" text-decoration="underline">&lt;geoDecl&gt;</basic-link> element supplied in the TEI header, using the <inline font-style="italic">decls</inline> attribute. If no such link is made, the assumption is that the content of each <basic-link internal-destination="TEI.geo" text-decoration="underline">&lt;geo&gt;</basic-link> element will be a pair of numbers separated by whitespace, to be interpreted as latitude followed by longitude according to the World Geodetic System.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;geoDecl xml:id="WGS" datum="WGS84"&gt;</inline>World Geodetic System<inline>&lt;/geoDecl&gt;</inline>
<inline>&lt;geoDecl xml:id="OS" datum="OSGB36"&gt;</inline>Ordnance Survey<inline>&lt;/geoDecl&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
<inline>&lt;location&gt;</inline>
 <inline>&lt;desc&gt;</inline>A tombstone plus six lines of
   Anglo-Saxon text, built into the west tower (on the south side
   of the archway, at 8 ft. above the ground) of the
   Church of St. Mary-le-Wigford in Lincoln.<inline>&lt;/desc&gt;</inline>
 <inline>&lt;geo decls="#WGS"&gt;</inline>53.226658 -0.541254<inline>&lt;/geo&gt;</inline>
 <inline>&lt;geo decls="#OS"&gt;</inline>SK 97481 70947<inline>&lt;/geo&gt;</inline>
<inline>&lt;/location&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;geo&gt;</inline>41.687142 -74.870109<inline>&lt;/geo&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;textNode/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element geo
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.declaring.attributes,
   text
}</block></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.geoDecl" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">1.163. &lt;geoDecl&gt;</block><table text-align="left" font-size="9pt" id="d27e135216"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
<table-row><table-cell number-columns-spanned="2" border-before-style="solid" border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">&lt;geoDecl&gt; </inline>(geographic coordinates declaration) documents the notation and the datum used for geographic coordinates expressed as content of the <basic-link internal-destination="TEI.geo" text-decoration="underline">&lt;geo&gt;</basic-link> element elsewhere within the document. [<basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/HD.html#HDGDECL)">2.3.8. The Geographic Coordinates Declaration</basic-link>]</block></table-cell></table-row>
