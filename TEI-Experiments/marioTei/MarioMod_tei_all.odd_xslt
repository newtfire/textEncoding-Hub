<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link></inline></block><block><inline font-weight="bold">nets: </inline><inline><basic-link internal-destination="TEI.iNode" text-decoration="underline">iNode</basic-link> <basic-link internal-destination="TEI.leaf" text-decoration="underline">leaf</basic-link> <basic-link internal-destination="TEI.root" text-decoration="underline">root</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">A root, and zero or more internal nodes and leaves, but if there is an internal node, there must also be at least one leaf.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;tree n="ex2" arity="2" ord="partial"
 order="13"&gt;</inline>
 <inline>&lt;root xml:id="G-div1"
  children="#G-plu1 #G-exp1" ord="true"&gt;</inline>
  <inline>&lt;label&gt;</inline>/<inline>&lt;/label&gt;</inline>
 <inline>&lt;/root&gt;</inline>
 <inline>&lt;iNode xml:id="G-plu1"
  children="#G-exp2 #G-exp3" parent="#G-div1" ord="false"&gt;</inline>
  <inline>&lt;label&gt;</inline>+<inline>&lt;/label&gt;</inline>
 <inline>&lt;/iNode&gt;</inline>
 <inline>&lt;iNode xml:id="G-exp1"
  children="#G-plu2 #G-num2.3" parent="#G-div1" ord="true"&gt;</inline>
  <inline>&lt;label&gt;</inline>**<inline>&lt;/label&gt;</inline>
 <inline>&lt;/iNode&gt;</inline>
 <inline>&lt;iNode xml:id="G-exp2"
  children="#G-vara1 #G-num2.1" parent="#G-plu1" ord="true"&gt;</inline>
  <inline>&lt;label&gt;</inline>**<inline>&lt;/label&gt;</inline>
 <inline>&lt;/iNode&gt;</inline>
 <inline>&lt;iNode xml:id="G-exp3"
  children="#G-varb1 #G-num2.2" parent="#G-plu1" ord="true"&gt;</inline>
  <inline>&lt;label&gt;</inline>**<inline>&lt;/label&gt;</inline>
 <inline>&lt;/iNode&gt;</inline>
 <inline>&lt;iNode xml:id="G-plu2"
  children="#G-vara2 #G-varb2" parent="#G-exp1" ord="false"&gt;</inline>
  <inline>&lt;label&gt;</inline>+<inline>&lt;/label&gt;</inline>
 <inline>&lt;/iNode&gt;</inline>
 <inline>&lt;leaf xml:id="G-vara1" parent="#G-exp2"&gt;</inline>
  <inline>&lt;label&gt;</inline>a<inline>&lt;/label&gt;</inline>
 <inline>&lt;/leaf&gt;</inline>
 <inline>&lt;leaf xml:id="G-num2.1" parent="#G-exp2"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/leaf&gt;</inline>
 <inline>&lt;leaf xml:id="G-varb1" parent="#G-exp3"&gt;</inline>
  <inline>&lt;label&gt;</inline>b<inline>&lt;/label&gt;</inline>
 <inline>&lt;/leaf&gt;</inline>
 <inline>&lt;leaf xml:id="G-num2.2" parent="#G-exp3"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/leaf&gt;</inline>
 <inline>&lt;leaf xml:id="G-vara2" parent="#G-plu2"&gt;</inline>
  <inline>&lt;label&gt;</inline>a<inline>&lt;/label&gt;</inline>
 <inline>&lt;/leaf&gt;</inline>
 <inline>&lt;leaf xml:id="G-varb2" parent="#G-plu2"&gt;</inline>
  <inline>&lt;label&gt;</inline>b<inline>&lt;/label&gt;</inline>
 <inline>&lt;/leaf&gt;</inline>
 <inline>&lt;leaf xml:id="G-num2.3" parent="#G-exp1"&gt;</inline>
