ting" text-decoration="underline">writing</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.app" text-decoration="underline">app</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link></inline></block><block><inline font-weight="bold">textstructure: </inline><inline><basic-link internal-destination="TEI.floatingText" text-decoration="underline">floatingText</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.addSpan" text-decoration="underline">addSpan</basic-link> <basic-link internal-destination="TEI.am" text-decoration="underline">am</basic-link> <basic-link internal-destination="TEI.damage" text-decoration="underline">damage</basic-link> <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">damageSpan</basic-link> <basic-link internal-destination="TEI.delSpan" text-decoration="underline">delSpan</basic-link> <basic-link internal-destination="TEI.ex" text-decoration="underline">ex</basic-link> <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link> <basic-link internal-destination="TEI.handShift" text-decoration="underline">handShift</basic-link> <basic-link internal-destination="TEI.listTranspose" text-decoration="underline">listTranspose</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.mod" text-decoration="underline">mod</basic-link> <basic-link internal-destination="TEI.redo" text-decoration="underline">redo</basic-link> <basic-link internal-destination="TEI.restore" text-decoration="underline">restore</basic-link> <basic-link internal-destination="TEI.retrace" text-decoration="underline">retrace</basic-link> <basic-link internal-destination="TEI.secl" text-decoration="underline">secl</basic-link> <bas