<table-row><table-cell padding="2pt" text-align="left"><block>name</block></table-cell><table-cell padding="2pt" text-align="left"><block>a single word which follows the rules defining a legal XML name (see <basic-link external-destination="url(https://www.w3.org/TR/REC-xml/#dt-name)">https://www.w3.org/TR/REC-xml/#dt-name</basic-link>), indicating the name of the feature being declared; matches the <inline font-style="italic">name</inline> attribute of <basic-link internal-destination="TEI.f" text-decoration="underline">&lt;f&gt;</basic-link> elements in the text.<table text-align="left" font-size="9pt" id="d27e104817"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><inline>Required</inline></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.name" text-decoration="underline">teidata.name</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>optional</block></table-cell><table-cell padding="2pt" text-align="left"><block>indicates whether or not the value of this feature may be present.<table text-align="left" font-size="9pt" id="d27e104841"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.truthValue" text-decoration="underline">teidata.truthValue</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Default</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>true</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">If a feature is marked as optional, it is possible for it to be omitted from a feature structure. If an obligatory feature is omitted, then it is understood to have a default value, either explicitly declared, or, if no default is supplied, the special value <inline>any</inline>. If an optional feature is omitted, then it is understood to be missing and any possible value (including the default) is ignored.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.fsDecl" text-decoration="underline">fsDecl</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.fDescr" text-decoration="underline">fDescr</basic-link> <basic-link internal-destination="TEI.vDefault" text-decoration="underline">vDefault</basic-link> <basic-link internal-destination="TEI.vRange" text-decoration="underline">vRange</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;fDecl name="INV"&gt;</inline>
 <inline>&lt;fDescr&gt;</inline>inverted sentence<inline>&lt;/fDescr&gt;</inline>
 <inline>&lt;vRange&gt;</inline>
  <inline>&lt;vAlt&gt;</inline>
   <inline>&lt;binary value="true"/&gt;</inline>
   <inline>&lt;binary value="false"/&gt;</inline>
  <inline>&lt;/vAlt&gt;</inline>
 <inline>&lt;/vRange&gt;</inline>
 <inline>&lt;vDefault&gt;</inline>
  <inline>&lt;binary value="false"/&gt;</inline>
 <inline>&lt;/vDefault&gt;</inline>
<inline>&lt;/fDecl&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;elementRef key="fDescr" minOccurs="0"/&gt;
  &lt;elementRef key="vRange"/&gt;
  &lt;elementRef key="vDefault" minOccurs="0"/&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element fDecl
{
   tei_att.global.attributes,
   tei_att.datcat.attributes,
   attribute name { text },
   attribute optional { text }?,
   ( tei_fDescr?, tei_vRange, tei_vDefault? )
}</block></block></table-cell></table-row></table-body></table>
