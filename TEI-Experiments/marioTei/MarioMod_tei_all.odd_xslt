    <inline>&lt;label&gt;</inline>NP<inline>&lt;/label&gt;</inline>
    <inline>&lt;eLeaf&gt;</inline>
     <inline>&lt;label&gt;</inline>you<inline>&lt;/label&gt;</inline>
    <inline>&lt;/eLeaf&gt;</inline>
   <inline>&lt;/eTree&gt;</inline>
   <inline>&lt;eTree xml:id="s1VP"&gt;</inline>
    <inline>&lt;label&gt;</inline>VP<inline>&lt;/label&gt;</inline>
    <inline>&lt;eTree xml:id="s1V"&gt;</inline>
     <inline>&lt;label&gt;</inline>V<inline>&lt;/label&gt;</inline>
     <inline>&lt;eLeaf&gt;</inline>
      <inline>&lt;label&gt;</inline>do<inline>&lt;/label&gt;</inline>
     <inline>&lt;/eLeaf&gt;</inline>
