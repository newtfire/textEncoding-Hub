element tagUsage
{
   tei_att.global.attributes,
   tei_att.datcat.attributes,
   attribute gi { text },
   attribute occurs { text }?,
   attribute withId { text }?,
   tei_macro.limitedContent
}</block></block></table-cell></table-row></table-body></table>
