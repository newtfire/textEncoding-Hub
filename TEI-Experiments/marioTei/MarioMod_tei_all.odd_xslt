<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;unitDecl&gt;</inline>
 <inline>&lt;unitDef xml:id="pechys" type="length"&gt;</inline>
  <inline>&lt;label&gt;</inline>πῆχυς<inline>&lt;/label&gt;</inline>
  <inline>&lt;placeName ref="#athens"/&gt;</inline>
  <inline>&lt;conversion fromUnit="#daktylos"
   toUnit="#pechys" formula="$fromUnit div 24"/&gt;</inline>
  <inline>&lt;desc&gt;</inline>Equivalent to a cubit or 24 daktyloi.<inline>&lt;/desc&gt;</inline>
 <inline>&lt;/unitDef&gt;</inline>
 <inline>&lt;unitDef xml:id="daktylos" type="length"&gt;</inline>
  <inline>&lt;label&gt;</inline>δάκτυλος<inline>&lt;/label&gt;</inline>
  <inline>&lt;placeName ref="#athens"/&gt;</inline>
  <inline>&lt;desc&gt;</inline>A basic unit of length equivalent to one finger (or the size of a thumb) in ancient Greece.<inline>&lt;/desc&gt;</inline>
 <inline>&lt;/unitDef&gt;</inline>
<inline>&lt;/unitDecl&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="1"
  maxOccurs="unbounded"&gt;
  &lt;classRef key="model.labelLike"
   minOccurs="1"/&gt;
  &lt;classRef key="model.placeNamePart"
   minOccurs="0"/&gt;
  &lt;elementRef key="conversion"
   minOccurs="0"/&gt;
  &lt;elementRef key="unit" minOccurs="0"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element unitDef
{
   tei_att.global.attributes,
   tei_att.canonical.attributes,
   tei_att.datable.attributes,
   tei_att.typed.attributes,
   (
      tei_model.labelLike
    | tei_model.placeNamePart?
    | tei_conversion?
    | tei_unit?
   )+
}</block></block></table-cell></table-row></table-body></table>
