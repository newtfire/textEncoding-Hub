on="underline">name</basic-link> <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link> <basic-link internal-destination="TEI.noteGrp" text-decoration="underline">noteGrp</basic-link> <basic-link internal-destination="TEI.pb" text-decoration="underline">pb</basic-link> <basic-link internal-destination="TEI.postBox" text-decoration="underline">postBox</basic-link> <basic-link internal-destination="TEI.postCode" text-decoration="underline">postCode</basic-link> <basic-link internal-destination="TEI.rs" text-decoration="underline">rs</basic-link> <basic-link internal-destination="TEI.street" text-decoration="underline">street</basic-link></inline></block><block><inline font-weight="bold">figures: </inline><inline><basic-link internal-destination="TEI.figure" text-decoration="underline">figure</basic-link> <basic-link internal-destination="TEI.notatedMusic" text-decoration="underline">notatedMusic</basic-link></inline></block><block><inline font-weight="bold">header: </inline><inline><basic-link internal-destination="TEI.idno" text-decoration="underline">idno</basic-link></inline></block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.fLib" text-decoration="underline">fLib</basic-link> <basic-link internal-destination="TEI.fs" text-decoration="underline">fs</basic-link> <basic-link internal-destination="TEI.fvLib" text-decoration="underline">fvLib</basic-link></inline></block><block><inline font-weight="bold">namesdates: </inline><inline><basic-link internal-destination="TEI.addName" text-decoration="underline">addName</basic-link> <basic-link internal-destination="TEI.bloc" text-decoration="underline">bloc</basic-link> <basic-link internal-destination="TEI.climate" text-decoration="underline">climate</basic-link> <basic-link internal-destination="TEI.country" text-decoration="underline">country</basic-link> <basic-link internal-destination="TEI.district" text-decoration="underline">dist