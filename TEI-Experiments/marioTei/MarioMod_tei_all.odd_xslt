" text-decoration="underline">listWit</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link></inline></block><block><inline font-weight="bold">textstructure: </inline><inline><basic-link internal-destination="TEI.argument" text-decoration="underline">argument</basic-link> <basic-link internal-destination="TEI.byline" text-decoration="underline">byline</basic-link> <basic-link internal-destination="TEI.closer" text-decoration="underline">closer</basic-link> <basic-link internal-destination="TEI.dateline" text-decoration="underline">dateline</basic-link> <basic-link internal-destination="TEI.docAuthor" text-decoration="underline">docAuthor</basic-link> <basic-link internal-destination="TEI.docDate" text-decoration="underline">docDate</basic-link> <basic-link internal-destination="TEI.epigraph" text-decoration="underline">epigraph</basic-link> <basic-link internal-destination="TEI.floatingText" text-decoration="underline">floatingText</basic-link> <basic-link internal-destination="TEI.opener" text-decoration="underline">opener</basic-link> <basic-link internal-destination="TEI.postscript" text-decoration="underline">postscript</basic-link> <basic-link internal-destination="TEI.salute" text-decoration="underline">salute</basic-link> <basic-link internal-destination="TEI.signed" text-decoration="underline">signed</basic-link> <basic-link internal-destination="TEI.trailer" text-decoration="underline">trailer</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.addSpan" text-decoration="underline">addSpan</basic-link> <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">damageSpan</basic-link> <basic-link internal-destination="TEI.delSpan" text-decoration="underline">delSpan</basic-link> <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link> <basic-link internal-destination="TEI.listTranspose" text-decoration="underline">listTranspose</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.space" text-decoration="underline">space</basic-link> <basic-link internal-destination="TEI.substJoin" text-decoration="underline">substJoin</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;prologue&gt;</inline>
 <inline>&lt;sp&gt;</inline>
  <inline>&lt;l&gt;</inline>Wits, like physicians never can agree,<inline>&lt;/l&gt;</inline>
  <inline>&lt;l&gt;</inline>When of a different society.<inline>&lt;/l&gt;</inline>
  <inline>&lt;l&gt;</inline>New plays are stuffed with wits, and with deboches,<inline>&lt;/l&gt;</inline>
  <inline>&lt;l&gt;</inline>That crowd and sweat like cits in May-Day coaches.<inline>&lt;/l&gt;</inline>
 <inline>&lt;/sp&gt;</inline>
 <inline>&lt;trailer&gt;</inline>Written by a person of quality<inline>&lt;/trailer&gt;</inline>
<inline>&lt;/prologue&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.divTop"/&gt;
   &lt;classRef key="model.global"/&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="1"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.common"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
  &lt;sequence minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.divBottom"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element prologue
{
   tei_att.global.attributes,
   (
      ( tei_model.divTop | tei_model.global )*,
      ( ( tei_model.common, tei_model.global* )+ ),
      ( ( tei_model.divBottom, tei_model.global* )* )
   )
}</block></block></table-cell></table-row></table-body></table>
