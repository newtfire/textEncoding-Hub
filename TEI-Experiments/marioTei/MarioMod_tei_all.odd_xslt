 <inline>&lt;castList&gt;</inline>
  <inline>&lt;castItem&gt;</inline>
   <inline>&lt;role xml:id="bellaf"&gt;</inline>Bellafront<inline>&lt;/role&gt;</inline>
  <inline>&lt;/castItem&gt;</inline>
<inline>&lt;!-- ... --&gt;</inline>
