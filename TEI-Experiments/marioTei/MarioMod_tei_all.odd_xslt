<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Legal values are:</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="6pt" space-after="6pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">set</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>indicates that the given values are organized as a set.</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">bag</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>indicates that the given values are organized as a bag (multiset).</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">list</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>indicates that the given values are organized as a list.</block></list-item-body></list-item></list-block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
