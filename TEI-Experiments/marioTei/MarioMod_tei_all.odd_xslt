<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">This attribute has a datatype of <inline color="black" font-family="Helvetica">teidata.truthValue</inline>, which may be represented by the values <inline>1</inline> or <inline>true</inline>, or <inline>0</inline> or <inline>false</inline>.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
