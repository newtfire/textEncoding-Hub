 <inline>&lt;msFrag&gt;</inline>
  <inline>&lt;msIdentifier&gt;</inline>
   <inline>&lt;settlement&gt;</inline>Ljubljana<inline>&lt;/settlement&gt;</inline>
   <inline>&lt;repository&gt;</inline>Narodna in univerzitetna knjiznica<inline>&lt;/repository&gt;</inline>
   <inline>&lt;idno&gt;</inline>MS Kopitar 2<inline>&lt;/idno&gt;</inline>
  <inline>&lt;/msIdentifier&gt;</inline>
  <inline>&lt;msContents&gt;</inline>
   <inline>&lt;summary&gt;</inline>Contains ff. 10 to 42 only<inline>&lt;/summary&gt;</inline>
  <inline>&lt;/msContents&gt;</inline>
 <inline>&lt;/msFrag&gt;</inline>
 <inline>&lt;msFrag&gt;</inline>
  <inline>&lt;msIdentifier&gt;</inline>
   <inline>&lt;settlement&gt;</inline>Warszawa<inline>&lt;/settlement&gt;</inline>
   <inline>&lt;repository&gt;</inline>Biblioteka Narodowa<inline>&lt;/repository&gt;</inline>
   <inline>&lt;idno&gt;</inline>BO 3.201<inline>&lt;/idno&gt;</inline>
  <inline>&lt;/msIdentifier&gt;</inline>
 <inline>&lt;/msFrag&gt;</inline>
 <inline>&lt;msFrag&gt;</inline>
  <inline>&lt;msIdentifier&gt;</inline>
   <inline>&lt;settlement&gt;</inline>Sankt-Peterburg<inline>&lt;/settlement&gt;</inline>
   <inline>&lt;repository&gt;</inline>Rossiiskaia natsional'naia biblioteka<inline>&lt;/repository&gt;</inline>
   <inline>&lt;idno&gt;</inline>Q.p.I.72<inline>&lt;/idno&gt;</inline>
  <inline>&lt;/msIdentifier&gt;</inline>
 <inline>&lt;/msFrag&gt;</inline>
<inline>&lt;/msDesc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
