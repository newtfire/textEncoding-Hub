<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">nets: </inline><inline><basic-link internal-destination="TEI.eTree" text-decoration="underline">eTree</basic-link> <basic-link internal-destination="TEI.forest" text-decoration="underline">forest</basic-link> <basic-link internal-destination="TEI.triangle" text-decoration="underline">triangle</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link></inline></block><block><inline font-weight="bold">nets: </inline><inline><basic-link internal-destination="TEI.eLeaf" text-decoration="underline">eLeaf</basic-link> <basic-link internal-destination="TEI.eTree" text-decoration="underline">eTree</basic-link> <basic-link internal-destination="TEI.triangle" text-decoration="underline">triangle</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">An optional label followed by zero or more embedding trees, triangles, or embedding leafs.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;triangle&gt;</inline>
 <inline>&lt;label&gt;</inline>NP<inline>&lt;/label&gt;</inline>
 <inline>&lt;eLeaf&gt;</inline>
  <inline>&lt;label&gt;</inline>the periscope<inline>&lt;/label&gt;</inline>
 <inline>&lt;/eLeaf&gt;</inline>
<inline>&lt;/triangle&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;elementRef key="label" minOccurs="0"/&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;elementRef key="eTree"/&gt;
   &lt;elementRef key="triangle"/&gt;
   &lt;elementRef key="eLeaf"/&gt;
  &lt;/alternate&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element triangle
{
   tei_att.global.attributes,
   attribute value { text }?,
   ( tei_label?, ( tei_eTree | tei_triangle | tei_eLeaf )* )
