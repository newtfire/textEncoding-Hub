decoration="underline">lb</basic-link> <basic-link internal-destination="TEI.media" text-decoration="underline">media</basic-link> <basic-link internal-destination="TEI.milestone" text-decoration="underline">milestone</basic-link> <basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link> <basic-link internal-destination="TEI.noteGrp" text-decoration="underline">noteGrp</basic-link> <basic-link internal-destination="TEI.pb" text-decoration="underline">pb</basic-link></inline></block><block><inline font-weight="bold">figures: </inline><inline><basic-link internal-destination="TEI.figure" text-decoration="underline">figure</basic-link> <basic-link internal-destination="TEI.formula" text-decoration="underline">formula</basic-link> <basic-link internal-destination="TEI.notatedMusic" text-decoration="underline">notatedMusic</basic-link></inline></block><block><inline font-weight="bold">iso-fs: </inline><inline><basic-link internal-destination="TEI.fLib" text-decoration="underline">fLib</basic-link> <basic-link internal-destination="TEI.fs" text-decoration="underline">fs</basic-link> <basic-link internal-destination="TEI.fvLib" text-decoration="underline">fvLib</basic-link></inline></block><block><inline font-weight="bold">spoken: </inline><inline><basic-link internal-destination="TEI.incident" text-decoration="underline">incident</basic-link> <basic-link internal-destination="TEI.kinesic" text-decoration="underline">kinesic</basic-link> <basic-link internal-destination="TEI.pause" text-decoration="underline">pause</basic-link> <basic-link internal-destination="TEI.shift" text-decoration="underline">shift</basic-link> <basic-link internal-destination="TEI.vocal" text-decoration="underline">vocal</basic-link> <basic-link internal-destination="TEI.writing" text-decoration="underline">writing</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.app" text-decoration="underline">app</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.addSpan" text-decoration="underline">addSpan</basic-link> <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">damageSpan</basic-link> <basic-link internal-destination="TEI.delSpan" text-decoration="underline">delSpan</basic-link> <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link> <basic-link internal-destination="TEI.line" text-decoration="underline">line</basic-link> <basic-link internal-destination="TEI.listTranspose" text-decoration="underline">listTranspose</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.path" text-decoration="underline">path</basic-link> <basic-link internal-destination="TEI.space" text-decoration="underline">space</basic-link> <basic-link internal-destination="TEI.substJoin" text-decoration="underline">substJoin</basic-link> <basic-link internal-destination="TEI.surface" text-decoration="underline">surface</basic-link> <basic-link internal-destination="TEI.surfaceGrp" text-decoration="underline">surfaceGrp</basic-link> <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The <basic-link internal-destination="TEI.surface" text-decoration="underline">&lt;surface&gt;</basic-link> element represents any two-dimensional or three-dimensional space on some physical surface forming part of the source material, such as a piece of paper, a face of a monument, a billboard, a scroll, a leaf etc.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">The coordinate space defined by this element may be thought of as a grid <inline font-style="italic">lrx</inline> - <inline font-style="italic">ulx</inline> units wide and <inline font-style="italic">uly</inline> - <inline font-style="italic">lry</inline> units high.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">The <basic-link internal-destination="TEI.surface" text-decoration="underline">&lt;surface&gt;</basic-link> element may contain graphic representations or transcriptions of written zones, or both. The coordinate values used by every <basic-link internal-destination="TEI.zone" text-decoration="underline">&lt;zone&gt;</basic-link> element contained by this element are to be understood with reference to the same grid.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">Where it is useful or meaningful to do so, any grouping of multiple <basic-link internal-destination="TEI.surface" text-decoration="underline">&lt;surface&gt;</basic-link> elements may be indicated using the <basic-link internal-destination="TEI.surfaceGrp" text-decoration="underline">&lt;surfaceGrp&gt;</basic-link> element.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;facsimile&gt;</inline>
 <inline>&lt;surface ulx="0" uly="0" lrx="200" lry="300"&gt;</inline>
  <inline>&lt;graphic url="Bovelles-49r.png"/&gt;</inline>
 <inline>&lt;/surface&gt;</inline>
<inline>&lt;/facsimile&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.global"/&gt;
   &lt;classRef key="model.labelLike"/&gt;
   &lt;classRef key="model.graphicLike"/&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;alternate&gt;
    &lt;elementRef key="zone"/&gt;
    &lt;elementRef key="line"/&gt;
    &lt;elementRef key="path"/&gt;
    &lt;elementRef key="surface"/&gt;
    &lt;elementRef key="surfaceGrp"/&gt;
   &lt;/alternate&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element surface
{
   tei_att.global.attributes,
   tei_att.coordinated.attributes,
   tei_att.declaring.attributes,
   tei_att.typed.attributes,
   attribute attachment { text }?,
   attribute flipping { text }?,
   (
      ( tei_model.global | tei_model.labelLike | tei_model.graphicLike )*,
      (
         (
            ( tei_zone | tei_line | tei_path | tei_surface | tei_surfaceGrp ),
            tei_model.global*
         )*
      )
   )
}</block></block></table-cell></table-row></table-body></table>
