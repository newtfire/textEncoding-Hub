<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">When a single page is being cited, use the <inline font-style="italic">from</inline> and <inline font-style="italic">to</inline> attributes with an identical value. When no clear endpoint is provided, the <inline font-style="italic">from</inline> attribute may be used without <inline font-style="italic">to</inline>; for example a citation such as ‘p. 3ff’ might be encoded <inline font-family="Courier">&lt;citedRange from="3"&gt;p. 3ff&lt;/citedRange&gt;</inline>.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;citedRange&gt;</inline>pp 12–13<inline>&lt;/citedRange&gt;</inline>
<inline>&lt;citedRange unit="page" from="12" to="13"/&gt;</inline>
<inline>&lt;citedRange unit="volume"&gt;</inline>II<inline>&lt;/citedRange&gt;</inline>
<inline>&lt;citedRange unit="page"&gt;</inline>12<inline>&lt;/citedRange&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;bibl&gt;</inline>
 <inline>&lt;ptr target="#mueller01"/&gt;</inline>, <inline>&lt;citedRange target="http://example.com/mueller3.xml#page4"&gt;</inline>vol. 3, pp.
   4-5<inline>&lt;/citedRange&gt;</inline>
<inline>&lt;/bibl&gt;</inline></block></block></table-cell></table-row>
