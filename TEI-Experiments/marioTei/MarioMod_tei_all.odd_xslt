<block keep-with-next.within-page="always" id="TEI.object" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">1.271. &lt;object&gt;</block><table text-align="left" font-size="9pt" id="d27e225880"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
<table-row><table-cell number-columns-spanned="2" border-before-style="solid" border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">&lt;object&gt; </inline>contains a description of a single identifiable physical object. [<basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/ND.html#NDOBJ)">14.3.6. Objects</basic-link>]</block></table-cell></table-row>
