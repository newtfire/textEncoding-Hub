l-destination="TEI.restore" text-decoration="underline">restore</basic-link> <basic-link internal-destination="TEI.retrace" text-decoration="underline">retrace</basic-link> <basic-link internal-destination="TEI.secl" text-decoration="underline">secl</basic-link> <basic-link internal-destination="TEI.sourceDoc" text-decoration="underline">sourceDoc</basic-link> <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link> <basic-link internal-destination="TEI.surface" text-decoration="underline">surface</basic-link> <basic-link internal-destination="TEI.surfaceGrp" text-decoration="underline">surfaceGrp</basic-link> <basic-link internal-destination="TEI.surplus" text-decoration="underline">surplus</basic-link> <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link></inline></block><block><inline font-weight="bold">verse: </inline><inline><basic-link internal-destination="TEI.rhyme" text-decoration="underline">rhyme</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Empty element</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Both the beginning and ending of the deleted sequence must be marked: the beginning by the <basic-link internal-destination="TEI.delSpan" text-decoration="underline">&lt;delSpan&gt;</basic-link> element, the ending by the target of the <inline font-style="italic">spanTo</inline> attribute.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">The text deleted must be at least partially legible, in order for the encoder to be able to transcribe it. If it is not legible at all, the <basic-link internal-destination="TEI.delSpan" text-decoration="underline">&lt;delSpan&gt;</basic-link> tag should not be used. Rather, the <basic-link internal-destination="TEI.gap" text-decoration="underline">&lt;gap&gt;</basic-link> tag should be employed to signal that text cannot be transcribed, with the value of the <inline font-style="italic">reason</inline> attribute giving the cause for the omission from the transcription as deletion. If it is not fully legible, the <basic-link internal-destination="TEI.unclear" text-decoration="underline">&lt;unclear&gt;</basic-link> element should be used to signal the areas of text which cannot be read with confidence. See further sections <basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHOM)">12.3.1.7. Text Omitted from or Supplied in the Transcription</basic-link> and, for the close association of the <basic-link internal-destination="TEI.delSpan" text-decoration="underline">&lt;delSpan&gt;</basic-link> tag with the <basic-link internal-destination="TEI.gap" text-decoration="underline">&lt;gap&gt;</basic-link>, <basic-link internal-destination="TEI.damage" text-decoration="underline">&lt;damage&gt;</basic-link>, <basic-link internal-destination="TEI.unclear" text-decoration="underline">&lt;unclear&gt;</basic-link> and <basic-link internal-destination="TEI.supplied" text-decoration="underline">&lt;supplied&gt;</basic-link> elements, <basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHCOMB)">12.3.3.2. Use of the gap, del, damage, unclear, and supplied Elements in Combination</basic-link>.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">The <basic-link internal-destination="TEI.delSpan" text-decoration="underline">&lt;delSpan&gt;</basic-link> tag should not be used for deletions made by editors or encoders. In these cases, either the <basic-link internal-destination="TEI.corr" text-decoration="underline">&lt;corr&gt;</basic-link> tag or the <basic-link internal-destination="TEI.gap" text-decoration="underline">&lt;gap&gt;</basic-link> tag should be used.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;p&gt;</inline>Paragraph partially deleted. This is the undeleted
 portion <inline>&lt;delSpan spanTo="#a23"/&gt;</inline>and this the deleted
 portion of the paragraph.<inline>&lt;/p&gt;</inline>
<inline>&lt;p&gt;</inline>Paragraph deleted together with adjacent material.<inline>&lt;/p&gt;</inline>
<inline>&lt;p&gt;</inline>Second fully deleted paragraph.<inline>&lt;/p&gt;</inline>
<inline>&lt;p&gt;</inline>Paragraph partially deleted; in the middle of this
 paragraph the deletion ends and the anchor point marks
 the resumption <inline>&lt;anchor xml:id="a23"/&gt;</inline> of the text. ...<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:rule context="tei:delSpan"&gt;
&lt;sch:assert test="@spanTo"&gt;The @spanTo attribute of &lt;&lt;sch:name/&gt;&gt; is required.&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:rule context="tei:delSpan"&gt;
&lt;sch:assert test="@spanTo"&gt;L'attribut spanTo est requis.&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;empty/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element delSpan
{
   tei_att.global.attributes,
   tei_att.dimensions.attributes,
   tei_att.spanning.attributes,
   tei_att.transcriptional.attributes,
   tei_att.typed.attributes,
   empty
}</block></block></table-cell></table-row></table-body></table>
