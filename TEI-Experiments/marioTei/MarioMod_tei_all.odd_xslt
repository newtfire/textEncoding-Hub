<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>This example is adapted from the Folger Library’s Early Modern English Drama version of <basic-link external-destination="url(https://emed.folger.edu/wits)">The Wits: a Comedy</basic-link> by William Davenant.<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;l&gt;</inline>
 <inline>&lt;w lemma="it" pos="pn"
  xml:id="A19883-003-a-0100"&gt;</inline>IT<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="have" pos="vvz"
  xml:id="A19883-003-a-0110"&gt;</inline>hath<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="be" pos="vvn"
  xml:id="A19883-003-a-0120"&gt;</inline>been<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="say" pos="vvn"
  xml:id="A19883-003-a-0130"&gt;</inline>said<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="of" pos="acp-p"
  xml:id="A19883-003-a-0140"&gt;</inline>of<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="old" pos="j"
  xml:id="A19883-003-a-0150"&gt;</inline>old<inline>&lt;/w&gt;</inline>
 <inline>&lt;pc xml:id="A19883-003-a-0160"&gt;</inline>,<inline>&lt;/pc&gt;</inline>
 <inline>&lt;w lemma="that" pos="cs"
  xml:id="A19883-003-a-0170"&gt;</inline>that<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="play" pos="vvz"
  xml:id="A19883-003-a-0180"&gt;</inline>
  <inline>&lt;choice&gt;</inline>
   <inline>&lt;orig&gt;</inline>Playes<inline>&lt;/orig&gt;</inline>
   <inline>&lt;reg&gt;</inline>Plays<inline>&lt;/reg&gt;</inline>
  <inline>&lt;/choice&gt;</inline>
 <inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="be" pos="vvb"
  xml:id="A19883-003-a-0190"&gt;</inline>are<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="feast" pos="n2"
  xml:id="A19883-003-a-0200"&gt;</inline>Feasts<inline>&lt;/w&gt;</inline>
 <inline>&lt;pc xml:id="A19883-003-a-0210"&gt;</inline>,<inline>&lt;/pc&gt;</inline>
<inline>&lt;/l&gt;</inline>
<inline>&lt;l xml:id="A19883-e100220"&gt;</inline>
 <inline>&lt;w lemma="poet" pos="n2"
  xml:id="A19883-003-a-0220"&gt;</inline>Poets<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="the" pos="d"
  xml:id="A19883-003-a-0230"&gt;</inline>the<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="cook" pos="n2"
  xml:id="A19883-003-a-0240"&gt;</inline>
  <inline>&lt;choice&gt;</inline>
   <inline>&lt;orig&gt;</inline>Cookes<inline>&lt;/orig&gt;</inline>
   <inline>&lt;reg&gt;</inline>Cooks<inline>&lt;/reg&gt;</inline>
  <inline>&lt;/choice&gt;</inline>
 <inline>&lt;/w&gt;</inline>
 <inline>&lt;pc xml:id="A19883-003-a-0250"&gt;</inline>,<inline>&lt;/pc&gt;</inline>
 <inline>&lt;w lemma="and" pos="cc"
  xml:id="A19883-003-a-0260"&gt;</inline>and<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="the" pos="d"
  xml:id="A19883-003-a-0270"&gt;</inline>the<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="spectator" pos="n2"
  xml:id="A19883-003-a-0280"&gt;</inline>Spectators<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="guest" pos="n2"
  xml:id="A19883-003-a-0290"&gt;</inline>Guests<inline>&lt;/w&gt;</inline>
 <inline>&lt;pc xml:id="A19883-003-a-0300"&gt;</inline>,<inline>&lt;/pc&gt;</inline>
<inline>&lt;/l&gt;</inline>
<inline>&lt;l xml:id="A19883-e100230"&gt;</inline>
 <inline>&lt;w lemma="the" pos="d"
  xml:id="A19883-003-a-0310"&gt;</inline>The<inline>&lt;/w&gt;</inline>
 <inline>&lt;w lemma="actor" pos="n2"
