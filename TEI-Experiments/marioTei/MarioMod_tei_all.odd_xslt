    <inline>&lt;/f&gt;</inline>
    <inline>&lt;f name="num"&gt;</inline>
     <inline>&lt;symbol value="pl"/&gt;</inline>
    <inline>&lt;/f&gt;</inline>
    <inline>&lt;f name="gender"&gt;</inline>
     <inline>&lt;symbol value="masc"/&gt;</inline>
