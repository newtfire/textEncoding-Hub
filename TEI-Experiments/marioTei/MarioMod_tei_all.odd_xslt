<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal">att.typed</block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="4pt" space-after="4pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>type</inline></block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>@subtype</inline></block></list-item-body></list-item></list-block></list-item-body></list-item></list-block><table text-align="left" font-size="9pt" id="d27e217990"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block>type</block></table-cell><table-cell padding="2pt" text-align="left"><block>provides a type for a node.<table text-align="left" font-size="9pt" id="d27e217997"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Derived from</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.att.typed" text-decoration="underline">att.typed</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.enumerated" text-decoration="underline">teidata.enumerated</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Suggested values include:</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="6pt" space-after="6pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">initial</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>initial node in a transition network</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">final</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>final node in a transition network</block></list-item-body></list-item></list-block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph&gt;</inline>
 <inline>&lt;node xml:id="gnex11"
  adjTo="#gnex12"
  adj="#gnex13"
  type="initial"&gt;</inline>
  <inline>&lt;label&gt;</inline>1<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex12"
  adjFrom="#gnex11"
  adjTo="#gnex13"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex13"
  adjFrom="#gnex12"
  adj="#gnex11"
  type="final"&gt;</inline>
  <inline>&lt;label&gt;</inline>3<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>value</block></table-cell><table-cell padding="2pt" text-align="left"><block>provides the value of a node, which is a feature structure or other analytic element.<table text-align="left" font-size="9pt" id="d27e218053"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>adjTo</block></table-cell><table-cell padding="2pt" text-align="left"><block>(adjacent to) gives the identifiers of the nodes which are adjacent to the current node.<table text-align="left" font-size="9pt" id="d27e218080"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link> separated by whitespace</block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph&gt;</inline>
 <inline>&lt;node xml:id="gnex21"
  adjTo="#gnex22"
  adj="#gnex23"
  type="initial"&gt;</inline>
  <inline>&lt;label&gt;</inline>1<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex22"
  adjTo="#gnex23"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex23"
  type="final"&gt;</inline>
  <inline>&lt;label&gt;</inline>3<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>adjFrom</block></table-cell><table-cell padding="2pt" text-align="left"><block>(adjacent from) gives the identifiers of the nodes which are adjacent from the current node.<table text-align="left" font-size="9pt" id="d27e218124"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link> separated by whitespace</block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph&gt;</inline>
 <inline>&lt;node xml:id="gnex31"
  type="initial"&gt;</inline>
  <inline>&lt;label&gt;</inline>1<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex32"
  adjFrom="#gnex31"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex33"
  adjFrom="#gnex32"
  adj="#gnex31"
  type="final"&gt;</inline>
  <inline>&lt;label&gt;</inline>3<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>adj</block></table-cell><table-cell padding="2pt" text-align="left"><block>(adjacent) gives the identifiers of the nodes which are both adjacent to and adjacent from the current node.<table text-align="left" font-size="9pt" id="d27e218168"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link> separated by whitespace</block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph&gt;</inline>
 <inline>&lt;node xml:id="gnex41"
  adj="#gnex42 #gnex43"
  type="initial"&gt;</inline>
  <inline>&lt;label&gt;</inline>1<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex42"
  adj="#gnex41 #gnex43"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex43"
  adj="#gnex42 #gnex41"
  type="final"&gt;</inline>
  <inline>&lt;label&gt;</inline>3<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">Use this attribute instead of the <inline font-style="italic">adjTo</inline> and <inline font-style="italic">adjFrom</inline> attributes when the graph is undirected and vice versa if the graph is directed.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>inDegree</block></table-cell><table-cell padding="2pt" text-align="left"><block>gives the in degree of the node, the number of nodes which are adjacent from the given node.<table text-align="left" font-size="9pt" id="d27e218222"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.count" text-decoration="underline">teidata.count</basic-link></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph&gt;</inline>
 <inline>&lt;node xml:id="gnex51"
  adjTo="#gnex52"
  adj="#gnex53"
  inDegree="1"
  type="initial"&gt;</inline>
  <inline>&lt;label&gt;</inline>1<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex52"
  adjFrom="#gnex51"
  adjTo="#gnex53"
  inDegree="2"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex53"
  adjFrom="#gnex52"
  adj="#gnex51"
  inDegree="2"
  type="final"&gt;</inline>
  <inline>&lt;label&gt;</inline>3<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>outDegree</block></table-cell><table-cell padding="2pt" text-align="left"><block>gives the out degree of the node, the number of nodes which are adjacent to the given node.<table text-align="left" font-size="9pt" id="d27e218255"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.count" text-decoration="underline">teidata.count</basic-link></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph&gt;</inline>
 <inline>&lt;node xml:id="gnex61"
  adjTo="#gnex62"
  adj="#gnex63"
  outDegree="2"
  type="initial"&gt;</inline>
  <inline>&lt;label&gt;</inline>1<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex62"
  adjFrom="#gnex61"
  adjTo="#gnex63"
  outDegree="1"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex63"
  adjFrom="#gnex62"
  adj="#gnex61"
  outDegree="2"
  type="final"&gt;</inline>
  <inline>&lt;label&gt;</inline>3<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>degree</block></table-cell><table-cell padding="2pt" text-align="left"><block>gives the degree of the node, the number of arcs with which the node is incident.<table text-align="left" font-size="9pt" id="d27e218288"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.count" text-decoration="underline">teidata.count</basic-link></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;graph&gt;</inline>
 <inline>&lt;node xml:id="gnex71"
  adjTo="#gnex72"
  adj="#gnex73"
  outDegree="1"
  inDegree="0"
  degree="1"
  type="initial"&gt;</inline>
  <inline>&lt;label&gt;</inline>1<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex72"
  adjFrom="#gnex71"
  adjTo="#gnex73"
  outDegree="1"
  inDegree="1"
  degree="0"&gt;</inline>
  <inline>&lt;label&gt;</inline>2<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
 <inline>&lt;node xml:id="gnex73"
  adjFrom="#gnex72"
  adj="#gnex71"
  outDegree="0"
  inDegree="1"
  degree="1"
  type="final"&gt;</inline>
  <inline>&lt;label&gt;</inline>3<inline>&lt;/label&gt;</inline>
 <inline>&lt;/node&gt;</inline>
<inline>&lt;/graph&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">Use this attribute instead of the <inline font-style="italic">inDegree</inline> and <inline font-style="italic">outDegree</inline> attributes when the graph is undirected and vice versa if the graph is directed.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">nets: </inline><inline><basic-link internal-destination="TEI.graph" text-decoration="underline">graph</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Zero, one, or two children <basic-link internal-destination="TEI.label" text-decoration="underline">&lt;label&gt;</basic-link> elements may be present. The first occurrence of <basic-link internal-destination="TEI.label" text-decoration="underline">&lt;label&gt;</basic-link> provides a label for the arc; the second provides a second label for the arc, and should be used if a transducer is being encoded whose actions are associated with nodes rather than with arcs.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;node xml:id="t6" type="final" inDegree="2"
 outDegree="0"&gt;</inline>
 <inline>&lt;label&gt;</inline>6<inline>&lt;/label&gt;</inline>
<inline>&lt;/node&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;elementRef key="label" minOccurs="0"
  maxOccurs="2"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element node
{
   tei_att.global.attributes,
   tei_att.typed.attribute.subtype,
   attribute type { "initial" | "final" }?,
   attribute value { text }?,
   attribute adjTo { list { + } }?,
   attribute adjFrom { list { + } }?,
   attribute adj { list { + } }?,
   attribute inDegree { text }?,
   attribute outDegree { text }?,
   attribute degree { text }?,
   ( ( tei_label, tei_label? )? )
}</block></block></table-cell></table-row></table-body></table>
