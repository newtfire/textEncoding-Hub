<table-row><table-cell padding="2pt" text-align="left"><block>name</block></table-cell><table-cell padding="2pt" text-align="left"><block>supplies a name for the kind of relationship of which this is an instance.<table text-align="left" font-size="9pt" id="d27e285137"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
