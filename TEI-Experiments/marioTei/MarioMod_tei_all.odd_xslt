<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Contains paragraphs or phrase level tags.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">This element should not be used outside the front or back matter; for similar contextual descriptions within the body of the text, use the <basic-link internal-destination="TEI.stage" text-decoration="underline">&lt;stage&gt;</basic-link> element.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;set&gt;</inline>
 <inline>&lt;p&gt;</inline>The action takes place on February 7th between the hours of noon and six in the
   afternoon, close to the Trenartha Tin Plate Works, on the borders of England and Wales,
   where a strike has been in progress throughout the winter.<inline>&lt;/p&gt;</inline>
<inline>&lt;/set&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;set&gt;</inline>
 <inline>&lt;head&gt;</inline>SCENE<inline>&lt;/head&gt;</inline>
 <inline>&lt;p&gt;</inline>A Sub-Post Office on a late autumn evening<inline>&lt;/p&gt;</inline>
<inline>&lt;/set&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;front&gt;</inline>
<inline>&lt;!-- &lt;titlePage&gt;, &lt;div type="Dedication"&gt;, etc. --&gt;</inline>
 <inline>&lt;set&gt;</inline>
  <inline>&lt;list type="gloss"&gt;</inline>
   <inline>&lt;label&gt;</inline>TIME<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>1907<inline>&lt;/item&gt;</inline>
   <inline>&lt;label&gt;</inline>PLACE<inline>&lt;/label&gt;</inline>
   <inline>&lt;item&gt;</inline>East Coast village in England<inline>&lt;/item&gt;</inline>
  <inline>&lt;/list&gt;</inline>
 <inline>&lt;/set&gt;</inline>
<inline>&lt;/front&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.headLike"/&gt;
   &lt;classRef key="model.global"/&gt;
  &lt;/alternate&gt;
  &lt;sequence minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.common"/&gt;
   &lt;classRef key="model.global"
    minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;/sequence&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element set
{
   tei_att.global.attributes,
   (
      ( tei_model.headLike | tei_model.global )*,
      ( ( tei_model.common, tei_model.global* )* )
   )
}</block></block></table-cell></table-row></table-body></table>
