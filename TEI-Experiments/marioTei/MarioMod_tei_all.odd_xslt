><inline><basic-link internal-destination="TEI.incident" text-decoration="underline">incident</basic-link> <basic-link internal-destination="TEI.kinesic" text-decoration="underline">kinesic</basic-link> <basic-link internal-destination="TEI.pause" text-decoration="underline">pause</basic-link> <basic-link internal-destination="TEI.shift" text-decoration="underline">shift</basic-link> <basic-link internal-destination="TEI.vocal" text-decoration="underline">vocal</basic-link> <basic-link internal-destination="TEI.writing" text-decoration="underline">writing</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.app" text-decoration="underline">app</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link></inline></block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.addSpan" text-decoration="underline">addSpan</basic-link> <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">damageSpan</basic-link> <basic-link internal-destination="TEI.delSpan" text-decoration="underline">delSpan</basic-link> <basic-link internal-destination="TEI.fw" text-decoration="underline">fw</basic-link> <basic-link internal-destination="TEI.listTranspose" text-decoration="underline">listTranspose</basic-link> <basic-link internal-destination="TEI.metamark" text-decoration="underline">metamark</basic-link> <basic-link internal-destination="TEI.space" text-decoration="underline">space</basic-link> <basic-link internal-destination="TEI.substJoin" text-decoration="underline">substJoin</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">May contain either a prose description organized as paragraphs, or a sequence of more specific demographic elements drawn from the <inline color="black" font-family="Helvetica">model.personPart</inline> class.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;person sex="F" age="adult"&gt;</inline>
 <inline>&lt;p&gt;</inline>Female respondent, well-educated, born in Shropshire UK, 12 Jan 1950, of unknown occupation. Speaks French fluently. Socio-Economic
   status B2.<inline>&lt;/p&gt;</inline>
<inline>&lt;/person&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;person sex="intersex" role="god"
 age="immortal"&gt;</inline>
 <inline>&lt;persName&gt;</inline>Hermaphroditos<inline>&lt;/persName&gt;</inline>
 <inline>&lt;persName xml:lang="grc"&gt;</inline>Ἑρμαφρόδιτος<inline>&lt;/persName&gt;</inline>
<inline>&lt;/person&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;person xml:id="Ovi01" sex="M" role="poet"&gt;</inline>
 <inline>&lt;persName xml:lang="en"&gt;</inline>Ovid<inline>&lt;/persName&gt;</inline>
 <inline>&lt;persName xml:lang="la"&gt;</inline>Publius Ovidius Naso<inline>&lt;/persName&gt;</inline>
 <inline>&lt;birth when="-0044-03-20"&gt;</inline> 20 March 43 BC <inline>&lt;placeName&gt;</inline>
   <inline>&lt;settlement type="city"&gt;</inline>Sulmona<inline>&lt;/settlement&gt;</inline>
   <inline>&lt;country key="IT"&gt;</inline>Italy<inline>&lt;/country&gt;</inline>
  <inline>&lt;/placeName&gt;</inline>
 <inline>&lt;/birth&gt;</inline>
 <inline>&lt;death notBefore="0017" notAfter="0018"&gt;</inline>17 or 18 AD <inline>&lt;placeName&gt;</inline>
   <inline>&lt;settlement type="city"&gt;</inline>Tomis (Constanta)<inline>&lt;/settlement&gt;</inline>
   <inline>&lt;country key="RO"&gt;</inline>Romania<inline>&lt;/country&gt;</inline>
  <inline>&lt;/placeName&gt;</inline>
 <inline>&lt;/death&gt;</inline>
<inline>&lt;/person&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>The following exemplifies an adaptation of the vCard standard to indicate an unknown gender for a fictional character.<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;person xml:id="ariel" gender="U"&gt;</inline>
 <inline>&lt;persName&gt;</inline>Ariel<inline>&lt;/persName&gt;</inline>
 <inline>&lt;note&gt;</inline>Character in <inline>&lt;title level="m"&gt;</inline>The Tempest<inline>&lt;/title&gt;</inline>.<inline>&lt;/note&gt;</inline>
<inline>&lt;/person&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>This example demonstrates the use of a <basic-link internal-destination="TEI.ref" text-decoration="underline">&lt;ref&gt;</basic-link> element to provide more information about a person. The private URI scheme <inline font-style="italic" font-weight="normal">lacy:</inline> is presumably declared in the <basic-link internal-destination="TEI.teiHeader" text-decoration="underline">&lt;teiHeader&gt;</basic-link> with a <basic-link internal-destination="TEI.prefixDef" text-decoration="underline">&lt;prefixDef&gt;</basic-link>.<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;person age="G2" role="author"
 xml:id="W0212" sex="F"&gt;</inline>
 <inline>&lt;birth when="1787"/&gt;</inline>
 <inline>&lt;death when="1855"/&gt;</inline>
 <inline>&lt;persName type="main"&gt;</inline>Mitford, Mary Russell (1787–1855)<inline>&lt;/persName&gt;</inline>
 <inline>&lt;persName resp="#Nicoll"&gt;</inline>MITFORD, MARY RUSSELL<inline>&lt;/persName&gt;</inline>
 <inline>&lt;listBibl type="lacyTitles"&gt;</inline>
  <inline>&lt;desc&gt;</inline>Lacy's Acting Editions<inline>&lt;/desc&gt;</inline>
  <inline>&lt;bibl&gt;</inline>
   <inline>&lt;ref target="lacy:L1280"&gt;</inline>Foscari<inline>&lt;/ref&gt;</inline>
  <inline>&lt;/bibl&gt;</inline>
  <inline>&lt;bibl&gt;</inline>
   <inline>&lt;ref target="lacy:L1337"&gt;</inline>Rienzi<inline>&lt;/ref&gt;</inline>
  <inline>&lt;/bibl&gt;</inline>
 <inline>&lt;/listBibl&gt;</inline>
 <inline>&lt;listRef type="seeAlso"&gt;</inline>
  <inline>&lt;ref target="https://www.victorianresearch.org/atcl/show_author.php?aid=1386"&gt;</inline>ATCL<inline>&lt;/ref&gt;</inline>
  <inline>&lt;ref target="https://doi.org/10.1093/ref:odnb/18859"&gt;</inline>ODNB<inline>&lt;/ref&gt;</inline>
  <inline>&lt;ref target="https://en.wikipedia.org/wiki/Mary_Russell_Mitford"&gt;</inline>Wikipedia<inline>&lt;/ref&gt;</inline>
  <inline>&lt;ref target="https://digitalmitford.org"&gt;</inline>Digital Mitford<inline>&lt;/ref&gt;</inline>
 <inline>&lt;/listRef&gt;</inline>
<inline>&lt;/person&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;classRef key="model.pLike" minOccurs="1"
   maxOccurs="unbounded"/&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.personPart"/&gt;
   &lt;classRef key="model.global"/&gt;
   &lt;classRef key="model.ptrLike"/&gt;
  &lt;/alternate&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element person
{
   tei_att.global.attributes,
   tei_att.datable.attributes,
   tei_att.editLike.attributes,
   tei_att.sortable.attributes,
   attribute role { list { + } }?,
   attribute sex { list { + } }?,
   attribute gender { list { + } }?,
   attribute age { text }?,
   (
      tei_model.pLike+
    | ( tei_model.personPart | tei_model.global | tei_model.ptrLike )*
   )
}</block></block></table-cell></table-row></table-body></table>
