 <inline>&lt;resp ref="http://id.loc.gov/vocabulary/relators/com.html"&gt;</inline>compiler<inline>&lt;/resp&gt;</inline>
 <inline>&lt;name&gt;</inline>Edward Child<inline>&lt;/name&gt;</inline>
<inline>&lt;/respStmt&gt;</inline></block></block></table-cell></table-row>
