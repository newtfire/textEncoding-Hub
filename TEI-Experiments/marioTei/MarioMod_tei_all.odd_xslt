<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">This element may be used as an alternative to <basic-link internal-destination="TEI.facsimile" text-decoration="underline">&lt;facsimile&gt;</basic-link> for TEI documents containing only page images, or for documents containing both images and transcriptions. Transcriptions may be provided within the <basic-link internal-destination="TEI.surface" text-decoration="underline">&lt;surface&gt;</basic-link> elements making up a source document, in parallel with them as part of a <basic-link internal-destination="TEI.text" text-decoration="underline">&lt;text&gt;</basic-link> element, or in both places if the encoder wishes to distinguish these two modes of transcription.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;sourceDoc&gt;</inline>
 <inline>&lt;surfaceGrp n="leaf1"&gt;</inline>
  <inline>&lt;surface facs="page1.png"&gt;</inline>
   <inline>&lt;zone&gt;</inline>All the writing on page 1<inline>&lt;/zone&gt;</inline>
  <inline>&lt;/surface&gt;</inline>
  <inline>&lt;surface&gt;</inline>
   <inline>&lt;graphic url="page2-highRes.png"/&gt;</inline>
   <inline>&lt;graphic url="page2-lowRes.png"/&gt;</inline>
   <inline>&lt;zone&gt;</inline>
    <inline>&lt;line&gt;</inline>A line of writing on page 2<inline>&lt;/line&gt;</inline>
    <inline>&lt;line&gt;</inline>Another line of writing on page 2<inline>&lt;/line&gt;</inline>
   <inline>&lt;/zone&gt;</inline>
  <inline>&lt;/surface&gt;</inline>
 <inline>&lt;/surfaceGrp&gt;</inline>
<inline>&lt;/sourceDoc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="1"
  maxOccurs="unbounded"&gt;
