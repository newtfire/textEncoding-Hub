<table-row><table-cell padding="2pt" text-align="left"><block>role</block></table-cell><table-cell padding="2pt" text-align="left"><block>specifies a primary role or classification for the persona.<table text-align="left" font-size="9pt" id="d27e254609"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
