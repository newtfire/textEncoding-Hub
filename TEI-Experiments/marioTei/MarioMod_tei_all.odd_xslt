l-destination="TEI.restore" text-decoration="underline">restore</basic-link> <basic-link internal-destination="TEI.retrace" text-decoration="underline">retrace</basic-link> <basic-link internal-destination="TEI.secl" text-decoration="underline">secl</basic-link> <basic-link internal-destination="TEI.sourceDoc" text-decoration="underline">sourceDoc</basic-link> <basic-link internal-destination="TEI.supplied" text-decoration="underline">supplied</basic-link> <basic-link internal-destination="TEI.surface" text-decoration="underline">surface</basic-link> <basic-link internal-destination="TEI.surfaceGrp" text-decoration="underline">surfaceGrp</basic-link> <basic-link internal-destination="TEI.surplus" text-decoration="underline">surplus</basic-link> <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link></inline></block><block><inline font-weight="bold">verse: </inline><inline><basic-link internal-destination="TEI.rhyme" text-decoration="underline">rhyme</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Empty element</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Both the beginning and ending of the damaged sequence must be marked: the beginning by the <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">&lt;damageSpan&gt;</basic-link> element, the ending by the target of the <inline font-style="italic">spanTo</inline> attribute: if no other element available, the <inline hyphenate="false" color="black" font-family="Courier">&lt;anchor&gt;</inline> element may be used for this purpose.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">The damaged text must be at least partially legible, in order for the encoder to be able to transcribe it. If it is not legible at all, the <basic-link internal-destination="TEI.damageSpan" text-decoration="underline">&lt;damageSpan&gt;</basic-link> element should not be used. Rather, the <basic-link internal-destination="TEI.gap" text-decoration="underline">&lt;gap&gt;</basic-link> or <basic-link internal-destination="TEI.unclear" text-decoration="underline">&lt;unclear&gt;</basic-link> element should be employed, with the value of the <inline font-style="italic">reason</inline> attribute giving the cause. See further sections <basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHDA)">12.3.3.1. Damage, Illegibility, and Supplied Text</basic-link> and <basic-link external-destination="url(https://www.tei-c.org/release/doc/tei-p5-doc/en/html/PH.html#PHCOMB)">12.3.3.2. Use of the gap, del, damage, unclear, and supplied Elements in Combination</basic-link>.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;p&gt;</inline>Paragraph partially damaged. This is the undamaged
 portion <inline>&lt;damageSpan spanTo="#a34"/&gt;</inline>and this the damaged
 portion of the paragraph.<inline>&lt;/p&gt;</inline>
<inline>&lt;p&gt;</inline>This paragraph is entirely damaged.<inline>&lt;/p&gt;</inline>
<inline>&lt;p&gt;</inline>Paragraph partially damaged; in the middle of this
 paragraph the damage ends and the anchor point marks
 the start of the <inline>&lt;anchor xml:id="a34"/&gt;</inline> undamaged part of the text. ...<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:rule context="tei:damageSpan"&gt;
&lt;sch:assert test="@spanTo"&gt;The @spanTo attribute of &lt;&lt;sch:name/&gt;&gt; is required.&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:rule context="tei:damageSpan"&gt;
&lt;sch:assert test="@spanTo"&gt;L'attribut spanTo est requis.&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;empty/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element damageSpan
{
   tei_att.global.attributes,
   tei_att.damaged.attributes,
   tei_att.spanning.attributes,
   tei_att.typed.attributes,
   empty
}</block></block></table-cell></table-row></table-body></table>
