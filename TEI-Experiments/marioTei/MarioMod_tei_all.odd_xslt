">rs</basic-link> <basic-link internal-destination="TEI.ruby" text-decoration="underline">ruby</basic-link> <basic-link internal-destination="TEI.s" text-decoration="underline">s</basic-link> <basic-link internal-destination="TEI.said" text-decoration="underline">said</basic-link> <basic-link internal-destination="TEI.salute" text-decoration="underline">salute</basic-link> <basic-link internal-destination="TEI.settlement" text-decoration="underline">settlement</basic-link> <basic-link internal-destination="TEI.shift" text-decoration="underline">shift</basic-link> <basic-link internal-destination="TEI.sic" text-decoration="underline">sic</basic-link> <basic-link internal-destination="TEI.signed" text-decoration="underline">signed</basic-link> <basic-link internal-destination="TEI.soCalled" text-decoration="underline">soCalled</basic-link> <basic-link internal-destination="TEI.span" text-decoration="underline">span</basic-link> <basic-link internal-destination="TEI.spanGrp" text-decoration="underline">spanGrp</basic-link> <basic-link internal-destination="TEI.stage" text-decoration="underline">stage</basic-link> <basic-link internal-destination="TEI.state" text-decoration="underline">state</basic-link> <basic-link internal-destination="TEI.surname" text-decoration="underline">surname</basic-link> <basic-link internal-destination="TEI.table" text-decoration="underline">table</basic-link> <basic-link internal-destination="TEI.term" text-decoration="underline">term</basic-link> <basic-link internal-destination="TEI.terrain" text-decoration="underline">terrain</basic-link> <basic-link internal-destination="TEI.time" text-decoration="underline">time</basic-link> <basic-link internal-destination="TEI.title" text-decoration="underline">title</basic-link> <basic-link internal-destination="TEI.trailer" text-decoration="underline">trailer</basic-link> <basic-link internal-destination="TEI.trait" text-decoration="underline">trait</basic-link> <basic-link internal-destination="TEI.unclear" text-decoration="underline">unclear</basic-link> <basic-link internal-destination="TEI.unit" text-decoration="underline">unit</basic-link> <basic-link internal-destination="TEI.vocal" text-decoration="underline">vocal</basic-link> <basic-link internal-destination="TEI.w" text-decoration="underline">w</basic-link> <basic-link internal-destination="TEI.writing" text-decoration="underline">writing</basic-link></inline></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Attributes</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><table text-align="left" font-size="9pt" id="d27e411626"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block>generatedBy</block></table-cell><table-cell padding="2pt" text-align="left"><block>(generated by) categorizes how the content of an element was generated in a CMC environment.<table text-align="left" font-size="9pt" id="d27e411637"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.enumerated" text-decoration="underline">teidata.enumerated</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block>
&lt;sch:rule context="tei:*[@generatedBy]"&gt;
&lt;sch:assert test="ancestor-or-self::tei:post"&gt;The @generatedBy attribute is for use within a &lt;post&gt; element.&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Suggested values include:</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="6pt" space-after="6pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">human</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>the content was ‘naturally’ typed or spoken by a human user</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">template</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>the content was generated after a human user activated a template for its insertion</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">system</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>the content was generated by the system, i.e. the CMC environment</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">bot</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>the content was generated by a bot, i.e. a non-human agent, typically one that is not part of the CMC environment itself</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="start" font-weight="bold" keep-together.within-line="always">unspecified</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><block> </block>the content was generated by an unknown or unspecified process</block></list-item-body></list-item></list-block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block>automatic system message in chat: user moves on to another chatroom<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;post type="event"
 generatedBy="system"
 who="#system"
 rend="color:blue"&gt;</inline>
 <inline>&lt;p&gt;</inline>
  <inline>&lt;name type="nickname"
   corresp="#A02"&gt;</inline>McMike<inline>&lt;/name&gt;</inline> geht
   in einen anderen Raum: <inline>&lt;name type="roomname"&gt;</inline>Kreuzfahrt<inline>&lt;/name&gt;</inline>
 <inline>&lt;/p&gt;</inline>
<inline>&lt;/post&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block>automatic system message in chat: user enters a chatroom<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;post type="event"
 generatedBy="system"&gt;</inline>
 <inline>&lt;p&gt;</inline>
  <inline>&lt;name type="nickname"
   corresp="#A08"&gt;</inline>c_bo<inline>&lt;/name&gt;</inline> betritt
   den Raum. <inline>&lt;/p&gt;</inline>
<inline>&lt;/post&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block>automatic system message in chat: user changes his font color<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;post type="event"
 generatedBy="system"
 rend="color:red"&gt;</inline>
 <inline>&lt;p&gt;</inline>
  <inline>&lt;name type="nickname"
   corresp="#A08"&gt;</inline>c_bo<inline>&lt;/name&gt;</inline> hat die
   Farbe gewechselt.
 <inline>&lt;/p&gt;</inline>
<inline>&lt;/post&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block>An automatic signature of user including an automatic timestamp (Wikipedia discussion, anonymized). The specification of <inline font-style="italic">generatedBy</inline> at the inner element <basic-link internal-destination="TEI.signed" text-decoration="underline">&lt;signed&gt;</basic-link> is meant to override the specification at the outer element <inline hyphenate="false" color="black" font-family="Courier">&lt;post&gt;</inline>. This is generally possible when the outer <inline font-style="italic">generatedBy</inline> value is "human".<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;post type="standard"
 generatedBy="human"
 indentLevel="2"
 synch="#t00394407"
 who="#WU00005582"&gt;</inline>
 <inline>&lt;p&gt;</inline> Kurze Nachfrage: Die Hieros für den Goldnamen stammen
   auch von Beckerath gem. Literatur ? Grüße --<inline>&lt;/p&gt;</inline>
 <inline>&lt;signed generatedBy="template"
  rend="inline"&gt;</inline>
  <inline>&lt;gap reason="signatureContent"/&gt;</inline>
  <inline>&lt;time generatedBy="template"&gt;</inline>18:50, 22. Okt. 2008 (CEST)<inline>&lt;/time&gt;</inline>
 <inline>&lt;/signed&gt;</inline>
<inline>&lt;/post&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell number-columns-spanned="2" padding="2pt" text-align="left"><block>Wikipedia talk page: user signature<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;post type="written"
 generatedBy="human"&gt;</inline>
<inline>&lt;!-- ... main content of posting ... --&gt;</inline>
 <inline>&lt;signed generatedBy="template"&gt;</inline>
  <inline>&lt;gap reason="signatureContent"/&gt;</inline>
  <inline>&lt;time generatedBy="template"&gt;</inline>12:01, 12. Jun. 2009 (CEST)<inline>&lt;/time&gt;</inline>
 <inline>&lt;/signed&gt;</inline>
<inline>&lt;/post&gt;</inline></block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.att.coordinated" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">3.11. att.coordinated</block><table text-align="left" font-size="9pt" id="d27e411758"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
<table-row><table-cell number-columns-spanned="2" border-before-style="solid" border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">att.coordinated</inline> provides attributes that can be used to position their parent element within a two and three dimensional coordinate system.</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Module</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>transcr</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Members</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline><basic-link internal-destination="TEI.line" text-decoration="underline">line</basic-link> <basic-link internal-destination="TEI.path" text-decoration="underline">path</basic-link> <basic-link internal-destination="TEI.surface" text-decoration="underline">surface</basic-link> <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link></inline></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Attributes</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><table text-align="left" font-size="9pt" id="d27e411817"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block>start</block></table-cell><table-cell padding="2pt" text-align="left"><block>indicates the element within a transcription of the text containing at least the start of the writing represented by this zone or surface.<table text-align="left" font-size="9pt" id="d27e411824"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>ulx</block></table-cell><table-cell padding="2pt" text-align="left"><block>gives the x coordinate value for the upper left corner of a rectangular space.<table text-align="left" font-size="9pt" id="d27e411847"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.numeric" text-decoration="underline">teidata.numeric</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>uly</block></table-cell><table-cell padding="2pt" text-align="left"><block>gives the y coordinate value for the upper left corner of a rectangular space.<table text-align="left" font-size="9pt" id="d27e411870"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
