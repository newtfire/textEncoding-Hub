<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;layout columns="1" ruledLines="25 32"&gt;</inline>Most pages have between 25 and 32 long lines ruled in lead.<inline>&lt;/layout&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;layout columns="2" ruledLines="42"&gt;</inline>
 <inline>&lt;p&gt;</inline>2 columns of 42 lines ruled in ink, with central rule
   between the columns.<inline>&lt;/p&gt;</inline>
<inline>&lt;/layout&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;layout columns="1 2" writtenLines="40 50"&gt;</inline>
 <inline>&lt;p&gt;</inline>Some pages have 2 columns, with central rule
   between the columns; each column with between 40 and 50 lines of writing.<inline>&lt;/p&gt;</inline>
<inline>&lt;/layout&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;layout streams="3" columns="3"/&gt;</inline>
<inline>&lt;!-- Further down in document body --&gt;</inline>
<inline>&lt;div type="page"&gt;</inline>
 <inline>&lt;ab&gt;</inline>
  <inline>&lt;pb/&gt;</inline>
   一二三<inline>&lt;cb type="top-stream"/&gt;</inline>
   一二三<inline>&lt;cb type="mid-stream"/&gt;</inline>
   一二三<inline>&lt;cb type="bottom-stream"/&gt;</inline>
<inline>&lt;!-- cb here for demo purposes --&gt;</inline>
 <inline>&lt;/ab&gt;</inline>
<inline>&lt;/div&gt;</inline></block></block></table-cell></table-row>
