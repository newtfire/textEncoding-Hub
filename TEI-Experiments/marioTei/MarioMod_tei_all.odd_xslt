<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><basic-link internal-destination="TEI.fsDecl" text-decoration="underline">fsDecl</basic-link>/@baseTypes</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><basic-link internal-destination="TEI.index" text-decoration="underline">index</basic-link>/@indexName</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><basic-link internal-destination="TEI.tagUsage" text-decoration="underline">tagUsage</basic-link>/@gi</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><basic-link internal-destination="TEI.transcriptionDesc" text-decoration="underline">transcriptionDesc</basic-link>/@ident</block></list-item-body></list-item></list-block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
