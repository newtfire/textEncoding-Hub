<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.rb" text-decoration="underline">rb</basic-link> <basic-link internal-destination="TEI.rt" text-decoration="underline">rt</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>The word <inline font-style="italic" font-weight="normal">入学試験</inline> <inline font-style="italic" font-weight="normal">nyūgakushiken</inline> (university entrance exam) is glossed with a hiragana phonation guide.<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;p xml:lang="ja"&gt;</inline>
<inline>&lt;!--...--&gt;</inline>
 <inline>&lt;ruby&gt;</inline>
  <inline>&lt;rb&gt;</inline>入学試験<inline>&lt;/rb&gt;</inline>
  <inline>&lt;rt place="above"&gt;</inline>にゅうがくしけん<inline>&lt;/rt&gt;</inline>
 <inline>&lt;/ruby&gt;</inline>
<inline>&lt;!--...--&gt;</inline>
<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>This fictional example shows the initialism <inline font-style="italic" font-weight="normal">TEI</inline> glossed letter-by-letter with an IPA transcription.<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;ruby&gt;</inline>
 <inline>&lt;rb&gt;</inline>T<inline>&lt;/rb&gt;</inline>
 <inline>&lt;rt&gt;</inline>ti:<inline>&lt;/rt&gt;</inline>
<inline>&lt;/ruby&gt;</inline>
<inline>&lt;ruby&gt;</inline>
 <inline>&lt;rb&gt;</inline>E<inline>&lt;/rb&gt;</inline>
 <inline>&lt;rt&gt;</inline>i:<inline>&lt;/rt&gt;</inline>
<inline>&lt;/ruby&gt;</inline>
<inline>&lt;ruby&gt;</inline>
 <inline>&lt;rb&gt;</inline>I<inline>&lt;/rb&gt;</inline>
 <inline>&lt;rt&gt;</inline>aɪ<inline>&lt;/rt&gt;</inline>
<inline>&lt;/ruby&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;elementRef key="rb" minOccurs="1"
   maxOccurs="1"/&gt;
  &lt;elementRef key="rt" minOccurs="1"
   maxOccurs="unbounded"/&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element ruby
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.typed.attributes,
   ( tei_rb, tei_rt+ )
}</block></block></table-cell></table-row></table-body></table>
