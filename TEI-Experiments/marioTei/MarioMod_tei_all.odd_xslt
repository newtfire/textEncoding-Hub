<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">A <basic-link internal-destination="TEI.roleName" text-decoration="underline">&lt;roleName&gt;</basic-link> may be distinguished from an <basic-link internal-destination="TEI.addName" text-decoration="underline">&lt;addName&gt;</basic-link> by virtue of the fact that, like a title, it typically exists independently of its holder.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;persName&gt;</inline>
 <inline>&lt;forename&gt;</inline>William<inline>&lt;/forename&gt;</inline>
 <inline>&lt;surname&gt;</inline>Poulteny<inline>&lt;/surname&gt;</inline>
 <inline>&lt;roleName&gt;</inline>Earl of Bath<inline>&lt;/roleName&gt;</inline>
<inline>&lt;/persName&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;p&gt;</inline>The <inline>&lt;roleName role="solicitor_general"&gt;</inline>S.G.<inline>&lt;/roleName&gt;</inline> is the only national public official,
 including the Supreme Court justices, required by statute to be “learned in the law.”<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;p&gt;</inline>
 <inline>&lt;persName ref="#NJF"&gt;</inline>
  <inline>&lt;roleName role="solicitor_general"&gt;</inline>Solicitor General<inline>&lt;/roleName&gt;</inline> Noel J. Francisco<inline>&lt;/persName&gt;</inline>,
 representing the administration, asserted in rebuttal that there was nothing to disavow (...)
<inline>&lt;persName ref="#NJF"&gt;</inline>Francisco<inline>&lt;/persName&gt;</inline> had violated the scrupulous standard of candor about the facts and
 the law that <inline>&lt;roleName role="solicitor_general"&gt;</inline>S.G.s<inline>&lt;/roleName&gt;</inline>, in Republican and Democratic administrations
 alike, have repeatedly said they must honor.
<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.phraseSeq"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element roleName
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
