 <inline>&lt;height quantity="12"/&gt;</inline>
 <inline>&lt;width quantity="10"/&gt;</inline>
 <inline>&lt;depth quantity="6"/&gt;</inline>
<inline>&lt;/measureGrp&gt;</inline></block></block></table-cell></table-row>
