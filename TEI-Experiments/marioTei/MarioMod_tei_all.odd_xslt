<table-row><table-cell padding="2pt" text-align="left"><block>from</block></table-cell><table-cell padding="2pt" text-align="left"><block>gives the identifier of the node which is adjacent from this arc.<table text-align="left" font-size="9pt" id="d27e18537"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><inline>Required</inline></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>to</block></table-cell><table-cell padding="2pt" text-align="left"><block>gives the identifier of the node which is adjacent to this arc.<table text-align="left" font-size="9pt" id="d27e18561"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><inline>Required</inline></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.pointer" text-decoration="underline">teidata.pointer</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">nets: </inline><inline><basic-link internal-destination="TEI.graph" text-decoration="underline">graph</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.label" text-decoration="underline">label</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The <basic-link internal-destination="TEI.arc" text-decoration="underline">&lt;arc&gt;</basic-link> element must be used if the arcs are labeled. Otherwise, arcs can be encoded using the <inline font-style="italic">adj</inline>, <inline font-style="italic">adjTo</inline> and <inline font-style="italic">adjFrom</inline> attributes on the <basic-link internal-destination="TEI.node" text-decoration="underline">&lt;node&gt;</basic-link> tags in the graph. Both <basic-link internal-destination="TEI.arc" text-decoration="underline">&lt;arc&gt;</basic-link> tags and adjacency attributes can be used, but the resulting encoding would be highly redundant.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">Zero, one, or two children <basic-link internal-destination="TEI.label" text-decoration="underline">&lt;label&gt;</basic-link> elements may be present. The first occurrence of <basic-link internal-destination="TEI.label" text-decoration="underline">&lt;label&gt;</basic-link> provides a label for the arc; the second provides a second label for the arc, and should be used if a transducer is being encoded.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;arc from="#T3" to="#T3"&gt;</inline>
 <inline>&lt;label&gt;</inline>OLD<inline>&lt;/label&gt;</inline>
 <inline>&lt;label&gt;</inline>VIEUX<inline>&lt;/label&gt;</inline>
<inline>&lt;/arc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;elementRef key="label" minOccurs="0"
