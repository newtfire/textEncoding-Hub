<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal">att.coordinated</block><list-block provisional-distance-between-starts="18pt" provisional-label-separation="6pt" text-indent="0em" margin-right="10pt" space-before="4pt" space-after="4pt"><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>points</inline></block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>@start</inline></block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>@ulx</inline></block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>@uly</inline></block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>@lrx</inline></block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
<block text-align="end">–</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><inline>@lry</inline></block></list-item-body></list-item></list-block></list-item-body></list-item></list-block><table text-align="left" font-size="9pt" id="d27e244649"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block>points</block></table-cell><table-cell padding="2pt" text-align="left"><block>identifies a line within the container or bounding box specified by the parent element by means of a series of two or more pairs of numbers, each of which gives the x,y coordinates of a point on the line.<table text-align="left" font-size="9pt" id="d27e244656"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Derived from</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.att.coordinated" text-decoration="underline">att.coordinated</basic-link></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>2–∞ occurrences of <basic-link internal-destination="TEI.teidata.point" text-decoration="underline">teidata.point</basic-link> separated by whitespace</block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Member of</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><basic-link internal-destination="TEI.model.linePart" text-decoration="underline">model.linePart</basic-link> </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">transcr: </inline><inline><basic-link internal-destination="TEI.line" text-decoration="underline">line</basic-link> <basic-link internal-destination="TEI.surface" text-decoration="underline">surface</basic-link> <basic-link internal-destination="TEI.zone" text-decoration="underline">zone</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Empty element</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Although the simplest form of a path is a straight line between two points, a line with more than two points may bend at any point. The order of coordinates in <inline font-style="italic">points</inline> is significant, because the line follows the coordinate sequence.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">To specify a closed polygon, use the <basic-link internal-destination="TEI.zone" text-decoration="underline">&lt;zone&gt;</basic-link> element rather than the <basic-link internal-destination="TEI.path" text-decoration="underline">&lt;path&gt;</basic-link> element.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;surface ulx="0" uly="0" lrx="443" lry="272"&gt;</inline>
 <inline>&lt;graphic url="facs-fig3.jpg"/&gt;</inline>
 <inline>&lt;path points="74,73 171,244"/&gt;</inline>
 <inline>&lt;path points="71,203 173,116"/&gt;</inline>
<inline>&lt;/surface&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Since a <basic-link internal-destination="TEI.path" text-decoration="underline">&lt;path&gt;</basic-link> represents a line with distinct start and end points, the last coordinate should not be the same as the first coordinate.<block>
&lt;sch:rule context="tei:path[@points]"&gt;
&lt;sch:let name="firstPair"
 value="tokenize( normalize-space( @points ), ' ')[1]"/&gt;
&lt;sch:let name="lastPair"
 value="tokenize( normalize-space( @points ), ' ')[last()]"/&gt;
&lt;sch:let name="firstX"
 value="xs:float( substring-before( $firstPair, ',') )"/&gt;
&lt;sch:let name="firstY"
 value="xs:float( substring-after( $firstPair, ',') )"/&gt;
&lt;sch:let name="lastX"
 value="xs:float( substring-before( $lastPair, ',') )"/&gt;
&lt;sch:let name="lastY"
 value="xs:float( substring-after( $lastPair, ',') )"/&gt;
&lt;sch:report test="$firstX eq $lastX and $firstY eq $lastY"&gt;The first and
 last elements of this path are the same. To specify a closed polygon, use
 the &lt;zone&gt; element rather than the &lt;path&gt; element. &lt;/sch:report&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;empty/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element path
{
   tei_att.global.attributes,
   tei_att.coordinated.attribute.start,
   tei_att.coordinated.attribute.ulx,
   tei_att.coordinated.attribute.uly,
   tei_att.coordinated.attribute.lrx,
   tei_att.coordinated.attribute.lry,
   tei_att.typed.attributes,
   tei_att.written.attributes,
   attribute points { list { * } }?,
   empty
}</block></block></table-cell></table-row></table-body></table>
