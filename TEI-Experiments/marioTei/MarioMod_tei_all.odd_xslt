<table-row><table-cell padding="2pt" text-align="left"><block>tag</block></table-cell><table-cell padding="2pt" text-align="left"><block>supplies a valid language tag for the language concerned.<table text-align="left" font-size="9pt" id="d27e170802"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
