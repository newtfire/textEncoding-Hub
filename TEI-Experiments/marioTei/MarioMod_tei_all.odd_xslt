<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">This attribute serves the same function as the <inline font-style="italic">hand</inline> attribute provided for those elements which are members of the <inline color="black" font-family="Helvetica">att.transcriptional</inline> class. It may be renamed at a subsequent major release.</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
