<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.note" text-decoration="underline">note</basic-link> <basic-link internal-destination="TEI.noteGrp" text-decoration="underline">noteGrp</basic-link></inline></block><block><inline font-weight="bold">textcrit: </inline><inline><basic-link internal-destination="TEI.lem" text-decoration="underline">lem</basic-link> <basic-link internal-destination="TEI.rdg" text-decoration="underline">rdg</basic-link> <basic-link internal-destination="TEI.rdgGrp" text-decoration="underline">rdgGrp</basic-link> <basic-link internal-destination="TEI.wit" text-decoration="underline">wit</basic-link> <basic-link internal-destination="TEI.witDetail" text-decoration="underline">witDetail</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">May contain readings and nested reading groups.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">Usually, only one <basic-link internal-destination="TEI.lem" text-decoration="underline">&lt;lem&gt;</basic-link> element should appear within a single apparatus entry, whether it appears outside a <basic-link internal-destination="TEI.rdgGrp" text-decoration="underline">&lt;rdgGrp&gt;</basic-link> element or within it.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;app&gt;</inline>
 <inline>&lt;lem wit="#El #Ra2"&gt;</inline>though<inline>&lt;/lem&gt;</inline>
 <inline>&lt;rdgGrp type="orthographic"&gt;</inline>
  <inline>&lt;rdg wit="#Hg"&gt;</inline>thogh<inline>&lt;/rdg&gt;</inline>
  <inline>&lt;rdg wit="#La"&gt;</inline>thouhe<inline>&lt;/rdg&gt;</inline>
 <inline>&lt;/rdgGrp&gt;</inline>
<inline>&lt;/app&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:rule context="tei:rdgGrp"&gt;
&lt;sch:assert test="count(tei:lem) lt 2"&gt;Only one &lt;lem&gt; element may appear within a &lt;rdgGrp&gt;.&lt;/sch:assert&gt;
&lt;/sch:rule&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;elementRef key="lem" minOccurs="0"/&gt;
  &lt;alternate maxOccurs="unbounded"
   minOccurs="0"&gt;
   &lt;classRef key="model.rdgLike"/&gt;
   &lt;classRef key="model.noteLike"/&gt;
   &lt;elementRef key="witDetail"/&gt;
   &lt;elementRef key="wit"/&gt;
   &lt;elementRef key="rdgGrp"/&gt;
  &lt;/alternate&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element rdgGrp
{
   tei_att.global.attributes,
   tei_att.textCritical.attributes,
   (
      tei_lem?,
      (
         tei_model.rdgLike
       | tei_model.noteLike
       | tei_witDetail
       | tei_wit
       | tei_rdgGrp
      )*
   )
}</block></block></table-cell></table-row></table-body></table>
