<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">A view is a particular form of stage direction.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;view&gt;</inline>
 <inline>&lt;name&gt;</inline>Max<inline>&lt;/name&gt;</inline> joins his daughter
 at the window. <inline>&lt;hi&gt;</inline>Rain<inline>&lt;/hi&gt;</inline> sprays his
 face-- 
<inline>&lt;/view&gt;</inline>
<inline>&lt;view&gt;</inline>
 <inline>&lt;camera&gt;</inline>Max's POV<inline>&lt;/camera&gt;</inline> He sees occasional
 windows open, and just across from his apartment
 house, a <inline>&lt;hi&gt;</inline>man<inline>&lt;/hi&gt;</inline> opens the front door of
 a brownstone--
<inline>&lt;/view&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;div type="shot"&gt;</inline>
 <inline>&lt;view&gt;</inline>BBC World symbol<inline>&lt;/view&gt;</inline>
 <inline>&lt;sp&gt;</inline>
  <inline>&lt;speaker&gt;</inline>Voice Over<inline>&lt;/speaker&gt;</inline>
  <inline>&lt;p&gt;</inline>Monty Python's Flying Circus tonight comes to you live
     from the Grillomat Snack Bar, Paignton.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/sp&gt;</inline>
<inline>&lt;/div&gt;</inline>
<inline>&lt;div type="shot"&gt;</inline>
 <inline>&lt;view&gt;</inline>Interior of a nasty snack bar. Customers around, preferably
   real people. Linkman sitting at one of the plastic tables.<inline>&lt;/view&gt;</inline>
 <inline>&lt;sp&gt;</inline>
  <inline>&lt;speaker&gt;</inline>Linkman<inline>&lt;/speaker&gt;</inline>
  <inline>&lt;p&gt;</inline>Hello to you live from the Grillomat Snack Bar.
  <inline>&lt;/p&gt;</inline>
 <inline>&lt;/sp&gt;</inline>
<inline>&lt;/div&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.specialPara"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element view
{
   tei_att.global.attributes,
   tei_att.performed.attributes,
   tei_macro.specialPara
}</block></block></table-cell></table-row></table-body></table>
