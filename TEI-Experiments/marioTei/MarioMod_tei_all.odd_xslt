<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">Generally, each <basic-link internal-destination="TEI.interp" text-decoration="underline">&lt;interp&gt;</basic-link> element carries an <inline font-style="italic">xml:id</inline> attribute. This permits the encoder to explicitly associate the interpretation represented by the content of an <basic-link internal-destination="TEI.interp" text-decoration="underline">&lt;interp&gt;</basic-link> with any textual element through its <inline font-style="italic">ana</inline> attribute.</block><block line-height="1" text-indent="1em" space-before.optimum="0pt" space-before.maximum="12pt">Alternatively (or, in addition) an <basic-link internal-destination="TEI.interp" text-decoration="underline">&lt;interp&gt;</basic-link> may carry an <inline font-style="italic">inst</inline> attribute that points to one or more textual elements to which the analysis represented by the content of the <basic-link internal-destination="TEI.interp" text-decoration="underline">&lt;interp&gt;</basic-link> applies.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;interp type="structuralunit"
 xml:id="ana_am"&gt;</inline>aftermath<inline>&lt;/interp&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate minOccurs="0"
  maxOccurs="unbounded"&gt;
  &lt;textNode/&gt;
  &lt;classRef key="model.gLike"/&gt;
  &lt;classRef key="model.descLike"/&gt;
  &lt;classRef key="model.certLike"/&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element interp
{
   tei_att.global.attributes,
