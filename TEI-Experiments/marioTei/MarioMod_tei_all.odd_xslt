<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;physDesc&gt;</inline>
 <inline>&lt;objectDesc form="codex"&gt;</inline>
  <inline>&lt;supportDesc material="perg"&gt;</inline>
   <inline>&lt;support&gt;</inline>Parchment.<inline>&lt;/support&gt;</inline>
   <inline>&lt;extent&gt;</inline>i + 55 leaves
   <inline>&lt;dimensions scope="all" type="leaf"
     unit="inch"&gt;</inline>
     <inline>&lt;height&gt;</inline>7¼<inline>&lt;/height&gt;</inline>
     <inline>&lt;width&gt;</inline>5⅜<inline>&lt;/width&gt;</inline>
    <inline>&lt;/dimensions&gt;</inline>
   <inline>&lt;/extent&gt;</inline>
  <inline>&lt;/supportDesc&gt;</inline>
  <inline>&lt;layoutDesc&gt;</inline>
   <inline>&lt;layout columns="2"&gt;</inline>In double columns.<inline>&lt;/layout&gt;</inline>
  <inline>&lt;/layoutDesc&gt;</inline>
 <inline>&lt;/objectDesc&gt;</inline>
 <inline>&lt;handDesc&gt;</inline>
  <inline>&lt;p&gt;</inline>Written in more than one hand.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/handDesc&gt;</inline>
 <inline>&lt;decoDesc&gt;</inline>
  <inline>&lt;p&gt;</inline>With a few coloured capitals.<inline>&lt;/p&gt;</inline>
 <inline>&lt;/decoDesc&gt;</inline>
<inline>&lt;/physDesc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;classRef key="model.pLike" minOccurs="0"
   maxOccurs="unbounded"/&gt;
  &lt;classRef key="model.physDescPart"
   expand="sequenceOptional"/&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element physDesc
{
   tei_att.global.attributes,
   (
      tei_model.pLike*,
      tei_objectDesc?,
      tei_handDesc?,
      tei_typeDesc?,
      tei_scriptDesc?,
      tei_musicNotation?,
      tei_decoDesc?,
      tei_additions?,
      tei_bindingDesc?,
      tei_sealDesc?,
      tei_accMat?
   )
}</block></block></table-cell></table-row></table-body></table>
