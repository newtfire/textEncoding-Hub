<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Member of</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><basic-link internal-destination="TEI.model.profileDescPart" text-decoration="underline">model.profileDescPart</basic-link></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">header: </inline><inline><basic-link internal-destination="TEI.profileDesc" text-decoration="underline">profileDesc</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.p" text-decoration="underline">p</basic-link></inline></block><block><inline font-weight="bold">namesdates: </inline><inline><basic-link internal-destination="TEI.listOrg" text-decoration="underline">listOrg</basic-link> <basic-link internal-destination="TEI.listPerson" text-decoration="underline">listPerson</basic-link> <basic-link internal-destination="TEI.org" text-decoration="underline">org</basic-link> <basic-link internal-destination="TEI.person" text-decoration="underline">person</basic-link> <basic-link internal-destination="TEI.personGrp" text-decoration="underline">personGrp</basic-link></inline></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">May contain a prose description organized as paragraphs, or a structured list of persons and person groups, with an optional formal specification of any relationships amongst them.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;particDesc&gt;</inline>
 <inline>&lt;listPerson&gt;</inline>
  <inline>&lt;person xml:id="P-1234" sex="2" age="mid"&gt;</inline>
   <inline>&lt;p&gt;</inline>Female informant, well-educated, born in
       Shropshire UK, 12 Jan 1950, of unknown occupation. Speaks French fluently.
       Socio-Economic status B2.<inline>&lt;/p&gt;</inline>
  <inline>&lt;/person&gt;</inline>
  <inline>&lt;person xml:id="P-4332" sex="1"&gt;</inline>
   <inline>&lt;persName&gt;</inline>
    <inline>&lt;surname&gt;</inline>Hancock<inline>&lt;/surname&gt;</inline>
    <inline>&lt;forename&gt;</inline>Antony<inline>&lt;/forename&gt;</inline>
    <inline>&lt;forename&gt;</inline>Aloysius<inline>&lt;/forename&gt;</inline>
    <inline>&lt;forename&gt;</inline>St John<inline>&lt;/forename&gt;</inline>
   <inline>&lt;/persName&gt;</inline>
   <inline>&lt;residence notAfter="1959"&gt;</inline>
    <inline>&lt;address&gt;</inline>
     <inline>&lt;street&gt;</inline>Railway Cuttings<inline>&lt;/street&gt;</inline>
     <inline>&lt;settlement&gt;</inline>East Cheam<inline>&lt;/settlement&gt;</inline>
    <inline>&lt;/address&gt;</inline>
   <inline>&lt;/residence&gt;</inline>
   <inline>&lt;occupation&gt;</inline>comedian<inline>&lt;/occupation&gt;</inline>
  <inline>&lt;/person&gt;</inline>
  <inline>&lt;listRelation&gt;</inline>
   <inline>&lt;relation type="personal" name="spouse"
    mutual="#P-1234 #P-4332"/&gt;</inline>
  <inline>&lt;/listRelation&gt;</inline>
 <inline>&lt;/listPerson&gt;</inline>
<inline>&lt;/particDesc&gt;</inline></block>This example shows both a very simple person description, and a very detailed one, using some of the more specialized elements from the module for Names and Dates.</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schematron</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block>
&lt;sch:pattern is-a="declarable"&gt;
&lt;sch:param name="tde"
 value="tei:particDesc"/&gt;
&lt;/sch:pattern&gt;</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;alternate&gt;
  &lt;classRef key="model.pLike" minOccurs="1"
   maxOccurs="unbounded"/&gt;
  &lt;alternate minOccurs="1"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.personLike"/&gt;
   &lt;elementRef key="listPerson"/&gt;
   &lt;elementRef key="listOrg"/&gt;
  &lt;/alternate&gt;
 &lt;/alternate&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element particDesc
{
   tei_att.global.attributes,
   tei_att.declarable.attributes,
   (
      tei_model.pLike+
    | ( tei_model.personLike | tei_listPerson | tei_listOrg )+
   )
}</block></block></table-cell></table-row></table-body></table>
