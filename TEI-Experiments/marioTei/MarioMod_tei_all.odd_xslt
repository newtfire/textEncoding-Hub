<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;titlePage&gt;</inline>
 <inline>&lt;docTitle&gt;</inline>
  <inline>&lt;titlePart type="main"&gt;</inline>THOMAS OF Reading.<inline>&lt;/titlePart&gt;</inline>
  <inline>&lt;titlePart type="alt"&gt;</inline>OR, The sixe worthy yeomen of the West.<inline>&lt;/titlePart&gt;</inline>
 <inline>&lt;/docTitle&gt;</inline>
 <inline>&lt;docEdition&gt;</inline>Now the fourth time corrected and enlarged<inline>&lt;/docEdition&gt;</inline>
 <inline>&lt;byline&gt;</inline>By T.D.<inline>&lt;/byline&gt;</inline>
 <inline>&lt;figure&gt;</inline>
  <inline>&lt;head&gt;</inline>TP<inline>&lt;/head&gt;</inline>
  <inline>&lt;p&gt;</inline>Thou shalt labor till thou returne to duste<inline>&lt;/p&gt;</inline>
  <inline>&lt;figDesc&gt;</inline>Printers Ornament used by TP<inline>&lt;/figDesc&gt;</inline>
 <inline>&lt;/figure&gt;</inline>
 <inline>&lt;docImprint&gt;</inline>Printed at <inline>&lt;name type="place"&gt;</inline>London<inline>&lt;/name&gt;</inline> for <inline>&lt;name&gt;</inline>T.P.<inline>&lt;/name&gt;</inline>
  <inline>&lt;date&gt;</inline>1612.<inline>&lt;/date&gt;</inline>
 <inline>&lt;/docImprint&gt;</inline>
<inline>&lt;/titlePage&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;sequence&gt;
  &lt;classRef key="model.global"
   minOccurs="0" maxOccurs="unbounded"/&gt;
  &lt;classRef key="model.titlepagePart"/&gt;
  &lt;alternate minOccurs="0"
   maxOccurs="unbounded"&gt;
   &lt;classRef key="model.titlepagePart"/&gt;
   &lt;classRef key="model.global"/&gt;
  &lt;/alternate&gt;
 &lt;/sequence&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element titlePage
{
   tei_att.global.attributes,
   tei_att.typed.attribute.subtype,
   attribute type { text }?,
   (
      tei_model.global*,
      tei_model.titlepagePart,
      ( tei_model.titlepagePart | tei_model.global )*
   )
}</block></block></table-cell></table-row></table-body></table>
