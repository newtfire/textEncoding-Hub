<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><basic-link internal-destination="TEI.teidata.outputMeasurement" text-decoration="underline">teidata.outputMeasurement</basic-link></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block>height</block></table-cell><table-cell padding="2pt" text-align="left"><block>Where the media are displayed, indicates the display height.<table text-align="left" font-size="9pt" id="d27e434920"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
