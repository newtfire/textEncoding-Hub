<table-row><table-cell padding="2pt" text-align="left"><block>tags</block></table-cell><table-cell padding="2pt" text-align="left"><block>supplies one or more valid language tags for the languages specified.<table text-align="left" font-size="9pt" id="d27e170456"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Status</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>Optional</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Datatype</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block>1–∞ occurrences of <basic-link internal-destination="TEI.teidata.language" text-decoration="underline">teidata.language</basic-link> separated by whitespace</block></table-cell></table-row>
<table-row><table-cell padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell padding="2pt" text-align="left"><block><block line-height="1">This attribute should be supplied only if the element contains no <basic-link internal-destination="TEI.langKnown" text-decoration="underline">&lt;langKnown&gt;</basic-link> children. Its values are language ‘tags’ as defined in <basic-link external-destination="url(http://www.rfc-editor.org/rfc/rfc4646.txt)">RFC 4646</basic-link> or its successor</block></block></table-cell></table-row></table-body></table></block></table-cell></table-row></table-body></table></block></table-cell></table-row>
