<block text-align="end">•</block></list-item-label><list-item-body start-indent="body-start()"><block font-weight="normal"><basic-link internal-destination="TEI.application" text-decoration="underline">application</basic-link>/@ident</block></list-item-body></list-item><list-item space-before.optimum="4pt"><list-item-label end-indent="label-end()">
