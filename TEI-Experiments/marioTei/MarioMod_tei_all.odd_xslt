<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;fsDecl type="Agreement"&gt;</inline>
 <inline>&lt;fsDescr&gt;</inline>This type of feature structure encodes the features
   for subject-verb agreement in English<inline>&lt;/fsDescr&gt;</inline>
 <inline>&lt;fDecl name="PERS"&gt;</inline>
  <inline>&lt;fDescr&gt;</inline>person (first, second, or third)<inline>&lt;/fDescr&gt;</inline>
  <inline>&lt;vRange&gt;</inline>
   <inline>&lt;vAlt&gt;</inline>
    <inline>&lt;symbol value="first"/&gt;</inline>
    <inline>&lt;symbol value="second"/&gt;</inline>
    <inline>&lt;symbol value="third"/&gt;</inline>
   <inline>&lt;/vAlt&gt;</inline>
  <inline>&lt;/vRange&gt;</inline>
 <inline>&lt;/fDecl&gt;</inline>
 <inline>&lt;fDecl name="NUM"&gt;</inline>
  <inline>&lt;fDescr&gt;</inline>number (singular or plural)<inline>&lt;/fDescr&gt;</inline>
  <inline>&lt;vRange&gt;</inline>
   <inline>&lt;vAlt&gt;</inline>
    <inline>&lt;symbol value="singular"/&gt;</inline>
    <inline>&lt;symbol value="plural"/&gt;</inline>
   <inline>&lt;/vAlt&gt;</inline>
  <inline>&lt;/vRange&gt;</inline>
 <inline>&lt;/fDecl&gt;</inline>
<inline>&lt;/fsDecl&gt;</inline></block></block></table-cell></table-row>
