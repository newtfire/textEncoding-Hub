<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Contained by</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block><block><block><inline font-weight="bold">core: </inline><inline><basic-link internal-destination="TEI.imprint" text-decoration="underline">imprint</basic-link></inline></block><block><inline font-weight="bold">header: </inline><inline><basic-link internal-destination="TEI.textClass" text-decoration="underline">textClass</basic-link></inline></block></block></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">May contain</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Empty element</block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Note</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block line-height="1">The <inline font-style="italic">scheme</inline> attribute needs to be supplied only if more than one taxonomy has been declared.</block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;catRef scheme="#myTopics"
 target="#news #prov #sales2"/&gt;</inline>
<inline>&lt;!-- elsewhere --&gt;</inline>
<inline>&lt;taxonomy xml:id="myTopics"&gt;</inline>
 <inline>&lt;category xml:id="news"&gt;</inline>
  <inline>&lt;catDesc&gt;</inline>Newspapers<inline>&lt;/catDesc&gt;</inline>
 <inline>&lt;/category&gt;</inline>
 <inline>&lt;category xml:id="prov"&gt;</inline>
  <inline>&lt;catDesc&gt;</inline>Provincial<inline>&lt;/catDesc&gt;</inline>
 <inline>&lt;/category&gt;</inline>
 <inline>&lt;category xml:id="sales2"&gt;</inline>
  <inline>&lt;catDesc&gt;</inline>Low to average annual sales<inline>&lt;/catDesc&gt;</inline>
 <inline>&lt;/category&gt;</inline>
<inline>&lt;/taxonomy&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;empty/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
