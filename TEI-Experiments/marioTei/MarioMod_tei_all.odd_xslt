<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block>Here is an example of a <basic-link internal-destination="TEI.unit" text-decoration="underline">&lt;unit&gt;</basic-link> element holding a <inline font-style="italic">unitRef</inline> attribute that points to a definition of the unit in the TEI header.<block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;measure&gt;</inline>
 <inline>&lt;num&gt;</inline>3<inline>&lt;/num&gt;</inline>
 <inline>&lt;unit unitRef="#ell"&gt;</inline>ells<inline>&lt;/unit&gt;</inline>
<inline>&lt;/measure&gt;</inline>
<inline>&lt;!-- In the TEI Header: --&gt;</inline>
<inline>&lt;encodingDesc&gt;</inline>
 <inline>&lt;unitDecl&gt;</inline>
  <inline>&lt;unitDef xml:id="ell"&gt;</inline>
   <inline>&lt;label&gt;</inline>ell<inline>&lt;/label&gt;</inline>
   <inline>&lt;placeName ref="#iceland"/&gt;</inline>
   <inline>&lt;desc&gt;</inline>A unit of measure for cloth, roughly equivalent to 18 inches, or from an adult male’s elbow to the tip of the middle finger.<inline>&lt;/desc&gt;</inline>
  <inline>&lt;/unitDef&gt;</inline>
 <inline>&lt;/unitDecl&gt;</inline>
<inline>&lt;/encodingDesc&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;measure&gt;</inline>
 <inline>&lt;num&gt;</inline>2<inline>&lt;/num&gt;</inline>
 <inline>&lt;unit&gt;</inline>kg<inline>&lt;/unit&gt;</inline>
<inline>&lt;/measure&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;measure type="value"&gt;</inline>
 <inline>&lt;num&gt;</inline>3<inline>&lt;/num&gt;</inline>
 <inline>&lt;unit type="time" unit="min"&gt;</inline>minute<inline>&lt;/unit&gt;</inline>
<inline>&lt;/measure&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;measure type="interval"&gt;</inline>
 <inline>&lt;num atLeast="1.2"&gt;</inline>1.2<inline>&lt;/num&gt;</inline> to <inline>&lt;num atMost="5.6"&gt;</inline>5.6<inline>&lt;/num&gt;</inline>
 <inline>&lt;unit type="velocity" unit="km/h"&gt;</inline>km/h<inline>&lt;/unit&gt;</inline>
<inline>&lt;/measure&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Example</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt"><inline>&lt;p&gt;</inline>Light travels at <inline>&lt;num value="3E10"&gt;</inline>3×10^10<inline>&lt;/num&gt;</inline>
 <inline>&lt;unit type="rate" unit="cm/s"&gt;</inline>
  <inline>&lt;unit type="space"&gt;</inline>cm<inline>&lt;/unit&gt;</inline> per <inline>&lt;unit type="time"&gt;</inline>second<inline>&lt;/unit&gt;</inline>
 <inline>&lt;/unit&gt;</inline>.<inline>&lt;/p&gt;</inline></block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Content model</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
&lt;content&gt;
 &lt;macroRef key="macro.phraseSeq"/&gt;
&lt;/content&gt;
    </block></block></table-cell></table-row>
<table-row><table-cell border-after-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><inline font-weight="bold">Schema Declaration</inline></block></table-cell><table-cell border-after-style="solid" border-end-style="solid" border-start-style="solid" padding="2pt" text-align="left"><block><block font-family="Courier" background-color="lightgray" color="black" white-space-treatment="preserve" linefeed-treatment="preserve" white-space-collapse="false" wrap-option="no-wrap" text-indent="0em" hyphenate="false" start-indent="12pt" text-align="start" font-size="6pt" space-before.optimum="4pt" space-after.optimum="4pt">
element unit
{
   tei_att.global.attributes,
   tei_att.cmc.attributes,
   tei_att.measurement.attributes,
   tei_att.typed.attributes,
   tei_macro.phraseSeq
}</block></block></table-cell></table-row></table-body></table>
<block keep-with-next.within-page="always" id="TEI.unitDecl" text-align="left" font-family="Times" font-size="14pt" font-weight="bold" space-after="3pt" space-before.optimum="9pt" text-indent="0em">1.444. &lt;unitDecl&gt;</block><table text-align="left" font-size="9pt" id="d27e382362"><table-column column-number="1" column-width="25%"/><table-column column-number="2" column-width="75%"/><table-body text-indent="0pt">
