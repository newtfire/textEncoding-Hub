<table-row><table-cell padding="2pt" text-align="left"><block>size</block></table-cell><table-cell padding="2pt" text-align="left"><block>states the size of the graph, i.e., the number of its arcs.<table text-align="left" font-size="9pt" id="d27e141863"><table-column column-number="1" column-width="20%"/><table-column column-number="2" column-width="80%"/><table-body text-indent="0pt">
